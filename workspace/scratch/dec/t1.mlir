          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw1_3 = arith.constant 768 : i64
          %myd1_3 = arith.index_cast %mydie : index to i64
          %myd41_3 = arith.muli %myd1_3, %fourL : i64
          %lb1_3 = arith.addi %lw1_3, %myd41_3 : i64
          %lo1_3 = arith.addi %lb1_3, %steploc : i64
          %locP1_3 = llvm.getelementptr %locp[%lo1_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw1_3 = arith.constant 4416 : i64
          %ao1_3 = arith.addi %aw1_3, %lo1_3 : i64
          %arrP1_3 = llvm.getelementptr %locp[%ao1_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la1_3 = llvm.atomicrmw add %locP1_3, %t1_3 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar1_3 = llvm.atomicrmw add %arrP1_3, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last1_3 = arith.subi %mycnt_i, %one_s : i32
          %amLast1_3 = arith.cmpi eq, %ar1_3, %last1_3 : i32
          scf.if %amLast1_3 {
            %tot1_3 = llvm.load %locP1_3 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig1_3 = llvm.atomicrmw add %p1_3, %tot1_3 syncscope("") release : !llvm.ptr, i32
            %cnt1_3 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p1_3 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %nheads_t : i32
            scf.condition(%notYet)
          } do {
