              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %v0 = arith.muli %ix, %csliceV : index
                %bi:2 = scf.for %jj = %c0_s to %csliceV step %c1_s
                    iter_args(%bv = %negbig_s, %bidx = %zero_s) -> (f32, i32) {
                  %v = arith.addi %v0, %jj : index
                  %lv = memref.load %slg[%m, %v] : memref<2x256xf32>
                  %gt = arith.cmpf ogt, %lv, %bv : f32
                  %nv2 = arith.select %gt, %lv, %bv : f32
                  %vi = arith.index_cast %v : index to i32
                  %nx = arith.select %gt, %vi, %bidx : i32
                  scf.yield %nv2, %nx : f32, i32
                }
                memref.store %bi#0, %spv[%m, %ix] : memref<2x8xf32>
                memref.store %bi#1, %spi[%m, %ix] : memref<2x8xi32>
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lwx_12 = arith.constant 1344 : i64
          %mydx_12 = arith.index_cast %mydie : index to i64
          %myd4x_12 = arith.muli %mydx_12, %fourL : i64
          %lbx_12 = arith.addi %lwx_12, %myd4x_12 : i64
          %lox_12 = arith.addi %lbx_12, %steploc : i64
          %locPx_12 = llvm.getelementptr %locp[%lox_12] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %awx_12 = arith.constant 4416 : i64
          %aox_12 = arith.addi %awx_12, %lox_12 : i64
          %arrPx_12 = llvm.getelementptr %locp[%aox_12] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %lax_12 = llvm.atomicrmw add %locPx_12, %tx_12 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %arx_12 = llvm.atomicrmw add %arrPx_12, %one_s syncscope("agent") release : !llvm.ptr, i32
          %lastx_12 = arith.subi %mycnt_i, %one_s : i32
          %amLastx_12 = arith.cmpi eq, %arx_12, %lastx_12 : i32
          scf.if %amLastx_12 {
            %totx_12 = llvm.load %locPx_12 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sigx_12 = llvm.atomicrmw add %px_12, %totx_12 syncscope("") release : !llvm.ptr, i32
            %cntx_12 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %px_12 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %ntasks_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 13 -- one task: a reduction over the whole row, so it
          // cannot be split by output slice the way the matmuls can.
          %hsingle13_x = arith.constant 208 : index
          %ecx_13 = arith.constant 88 : i64
          %eox_13 = arith.addi %stepev, %ecx_13 : i64
          %px_13 = llvm.getelementptr %evptr[%eox_13] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %clx_13 = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hsingle13_x] : (i32, memref<3x2x224xi32>) -> i32
          %minex_13 = arith.cmpi eq, %clx_13, %zero_s : i32
          scf.if %minex_13 {
            scf.for %m = %c0_s to %nat step %c1_s {
              %rd:2 = scf.for %k = %c0_s to %ctasks step %c1_s
                  iter_args(%bv = %negbig_s, %bidx = %zero_s) -> (f32, i32) {
                %apv = memref.load %spv[%m, %k] : memref<2x8xf32>
                %api = memref.load %spi[%m, %k] : memref<2x8xi32>
                %gt = arith.cmpf ogt, %apv, %bv : f32
                %nv2 = arith.select %gt, %apv, %bv : f32
                %nx = arith.select %gt, %api, %bidx : i32
                scf.yield %nv2, %nx : f32, i32
              }
              // One next token per sequence: the argmax of the last active
              // position, and only once that slot is past the prompt. Fleet
              // guards the same write (persistent_kernel.cuh:396).
              %lastm = arith.subi %nat, %c1_s : index
              %isLastRow = arith.cmpi eq, %m, %lastm : index
              scf.if %isLastRow {
                %nxt = arith.addi %seq, %nat : index
                %past = arith.cmpi sge, %nxt, %plen_s : index
                scf.if %past {
                  memref.store %rd#1, %stok[%nxt] : memref<7xi32>
                }
              }
            }
            %sigx_13 = llvm.atomicrmw add %px_13, %n1_s syncscope("") release : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %px_13 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %n1_s : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
            %seqn = arith.addi %seq, %nat : index
            scf.yield %seqn : index
          }
        }

        air.herd @herd tile (%htx, %hty) in (%ntx=%c1_s, %nty=%c1_s) {
        }
      }
    }
    return
  }
}
