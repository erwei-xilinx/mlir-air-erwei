          %last1_4 = arith.subi %mycnt_i, %one_s : i32
          %amLast1_4 = arith.cmpi eq, %ar1_4, %last1_4 : i32
          scf.if %amLast1_4 {
            %tot1_4 = llvm.load %locP1_4 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig1_4 = llvm.atomicrmw add %p1_4, %tot1_4 syncscope("") release : !llvm.ptr, i32
            %cnt1_4 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
