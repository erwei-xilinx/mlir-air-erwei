                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
