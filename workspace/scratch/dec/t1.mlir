          %v2_wq = memref.load %Wqkv[%l, %k2_wq, %o_wq] : memref<2x128x256xf32>
          %d_wq = arith.subf %v2_wq, %mu_wq : f32
          %s_wq = arith.mulf %d_wq, %sqkvc : f32
          memref.store %s_wq, %Wqkv[%l, %k2_wq, %o_wq] : memref<2x128x256xf32>
        }
      }
    }
    scf.for %l = %c0 to %clayers step %c1 {
      scf.for %o_wo = %c0 to %cdim step %c1 {
        %sum_wo = scf.for %k_wo = %c0 to %cqw step %c1
            iter_args(%acc_wo = %fzero) -> (f32) {
          %v_wo = memref.load %Wo[%l, %k_wo, %o_wo] : memref<2x128x128xf32>
          %a_wo = arith.addf %acc_wo, %v_wo : f32
          scf.yield %a_wo : f32
        }
        %mu_wo = arith.divf %sum_wo, %fred_qw : f32
        scf.for %k2_wo = %c0 to %cqw step %c1 {
          %v2_wo = memref.load %Wo[%l, %k2_wo, %o_wo] : memref<2x128x128xf32>
          %d_wo = arith.subf %v2_wo, %mu_wo : f32
          %s_wo = arith.mulf %d_wo, %soc : f32
          memref.store %s_wo, %Wo[%l, %k2_wo, %o_wo] : memref<2x128x128xf32>
        }
      }
    }
    scf.for %l = %c0 to %clayers step %c1 {
      scf.for %o_gu = %c0 to %c2inter step %c1 {
        %isup = arith.cmpi uge, %o_gu, %cinter : index
        %scl = arith.select %isup, %suc, %sgc : f32
        %sum_gu = scf.for %k_gu = %c0 to %cdim step %c1
            iter_args(%acc_gu = %fzero) -> (f32) {
          %v_gu = memref.load %Wgu[%l, %k_gu, %o_gu] : memref<2x128x512xf32>
          %a_gu = arith.addf %acc_gu, %v_gu : f32
          scf.yield %a_gu : f32
        }
        %mu_gu = arith.divf %sum_gu, %fred_d : f32
        scf.for %k2_gu = %c0 to %cdim step %c1 {
          %v2_gu = memref.load %Wgu[%l, %k2_gu, %o_gu] : memref<2x128x512xf32>
          %d_gu = arith.subf %v2_gu, %mu_gu : f32
          %s_gu = arith.mulf %d_gu, %scl : f32
          memref.store %s_gu, %Wgu[%l, %k2_gu, %o_gu] : memref<2x128x512xf32>
        }
      }
    }
    scf.for %l = %c0 to %clayers step %c1 {
      scf.for %o_wd = %c0 to %cdim step %c1 {
        %sum_wd = scf.for %k_wd = %c0 to %cinter step %c1
            iter_args(%acc_wd = %fzero) -> (f32) {
          %v_wd = memref.load %Wd[%l, %k_wd, %o_wd] : memref<2x256x128xf32>
          %a_wd = arith.addf %acc_wd, %v_wd : f32
          scf.yield %a_wd : f32
        }
        %mu_wd = arith.divf %sum_wd, %fred_i : f32
        scf.for %k2_wd = %c0 to %cinter step %c1 {
          %v2_wd = memref.load %Wd[%l, %k2_wd, %o_wd] : memref<2x256x128xf32>
          %d_wd = arith.subf %v2_wd, %mu_wd : f32
          %s_wd = arith.mulf %d_wd, %sdc : f32
          memref.store %s_wd, %Wd[%l, %k2_wd, %o_wd] : memref<2x256x128xf32>
        }
      }
    }
    scf.for %l = %c0 to %clayers step %c1 {
      scf.for %hk = %c0 to %ckvh step %c1 {
        scf.for %d = %c0 to %chd step %c1 {
          %sk_s = scf.for %t = %c0 to %cpre step %c1
              iter_args(%a = %fzero) -> (f32) {
            %v = memref.load %Kc[%l, %t, %hk, %d] : memref<2x38x2x32xf32>
            %a2 = arith.addf %a, %v : f32
            scf.yield %a2 : f32
          }
          %sv_s = scf.for %t = %c0 to %cpre step %c1
              iter_args(%a = %fzero) -> (f32) {
            %v = memref.load %Vc[%l, %t, %hk, %d] : memref<2x38x2x32xf32>
            %a2 = arith.addf %a, %v : f32
            scf.yield %a2 : f32
          }
          %muk = arith.divf %sk_s, %fred_p : f32
          %muv = arith.divf %sv_s, %fred_p : f32
          scf.for %t = %c0 to %cpre step %c1 {
            %kv = memref.load %Kc[%l, %t, %hk, %d] : memref<2x38x2x32xf32>
            %kd = arith.subf %kv, %muk : f32
            %ks = arith.mulf %kd, %skc : f32
            memref.store %ks, %Kc[%l, %t, %hk, %d] : memref<2x38x2x32xf32>
            %vv = memref.load %Vc[%l, %t, %hk, %d] : memref<2x38x2x32xf32>
            %vd = arith.subf %vv, %muv : f32
            %vs = arith.mulf %vd, %svc : f32
            memref.store %vs, %Vc[%l, %t, %hk, %d] : memref<2x38x2x32xf32>
          }
        }
      }
    }

    %invsqrthd = arith.constant 1.76776695e-01 : f32
    %negbig = arith.constant -1.000000e30 : f32
    %rq = memref.alloc() : memref<256xf32>
    %rsc = memref.alloc() : memref<38xf32>
    %ra = memref.alloc() : memref<128xf32>
    %rao = memref.alloc() : memref<128xf32>
    %rxa = memref.alloc() : memref<128xf32>
    %rxr = memref.alloc() : memref<128xf32>
    %rgu = memref.alloc() : memref<512xf32>
    %ract = memref.alloc() : memref<256xf32>
    %seqend = scf.for %sp = %c0 to %csteps step %c1
        iter_args(%seq = %c0) -> (index) {
     // A step consumes as many tokens as are left of the prompt, capped at the
     // window, and one once the prompt is used up -- Fleet's
     // prepare_next_batch, which is `prompt_length - step` clamped for prefill
     // requests and 1 for decode requests (persistent_kernel.cuh:441-450). So
     // the slot the step appends at and the length it attends both move by the
     // step's own token count, not by a fixed stride.
     %rem = arith.subi %cplen, %seq : index
     %isPre = arith.cmpi sgt, %rem, %c0 : index
     %capped = arith.minsi %rem, %ctok : index
     %nat = arith.select %isPre, %capped, %c1 : index
     %wbase = arith.addi %cpre, %seq : index
     %curlen = arith.addi %wbase, %nat : index
     // embed: the step's input is the next slice of the token stream, which
     // for anything past the prompt is what the previous step produced
     scf.for %m = %c0 to %nat step %c1 {
       %tp = arith.addi %seq, %m : index
       %tk = memref.load %Tok[%tp] : memref<7xi32>
       %tki = arith.index_cast %tk : i32 to index
       scf.for %i = %c0 to %cdim step %c1 {
         %ev = memref.load %Emb[%tki, %i] : memref<256x128xf32>
         memref.store %ev, %ref[%m, %i] : memref<2x128xf32>
       }
     }
     scf.for %l = %c0 to %clayers step %c1 {
      // 0, 1, 2 for every token before any attention, because token m's scores
      // read what tokens before it appended.
      scf.for %m = %c0 to %nat step %c1 {
       %ss = scf.for %i = %c0 to %cdim step %c1
           iter_args(%s = %fzero) -> (f32) {
         %v = memref.load %ref[%m, %i] : memref<2x128xf32>
         %sq2 = arith.mulf %v, %v : f32
         %s2 = arith.addf %s, %sq2 : f32
         scf.yield %s2 : f32
       }
       %mean = arith.divf %ss, %fdim : f32
       %me = arith.addf %mean, %eps : f32
       %rms = math.sqrt %me : f32
       scf.for %i = %c0 to %cdim step %c1 {
         %v = memref.load %ref[%m, %i] : memref<2x128xf32>
         %nv = arith.divf %v, %rms : f32
         %nw = memref.load %N1[%l, %i] : memref<2x128xf32>
         %rv = arith.mulf %nv, %nw : f32
         memref.store %rv, %Rv[%m, %i] : memref<2x128xf32>
       }
       scf.for %n = %c0 to %cqkvo step %c1 {
         %acc = scf.for %i = %c0 to %cdim step %c1
             iter_args(%s = %fzero) -> (f32) {
           %rv = memref.load %Rv[%m, %i] : memref<2x128xf32>
           %wv = memref.load %Wqkv[%l, %i, %n] : memref<2x128x256xf32>
           %mu = arith.mulf %rv, %wv : f32
           %s2 = arith.addf %s, %mu : f32
           scf.yield %s2 : f32
         }
         memref.store %acc, %rq[%n] : memref<256xf32>
       }
       %pos = arith.addi %wbase, %m : index
       // q heads: per-head rmsnorm then rope, in place
       scf.for %h = %c0 to %cheads step %c1 {
         %hb = arith.muli %h, %chd : index
         %qs = scf.for %d = %c0 to %chd step %c1
             iter_args(%s = %fzero) -> (f32) {
           %hi = arith.addi %hb, %d : index
           %v = memref.load %rq[%hi] : memref<256xf32>
           %sq2 = arith.mulf %v, %v : f32
           %s2 = arith.addf %s, %sq2 : f32
           scf.yield %s2 : f32
         }
         %qm = arith.divf %qs, %fhd : f32
         %qm2 = arith.addf %qm, %eps : f32
         %qr = math.sqrt %qm2 : f32
         scf.for %d = %c0 to %chd step %c1 {
           %hi = arith.addi %hb, %d : index
           %v = memref.load %rq[%hi] : memref<256xf32>
           %nv = arith.divf %v, %qr : f32
           %nw = memref.load %QKN[%l, %d] : memref<2x64xf32>
           %o2 = arith.mulf %nv, %nw : f32
           memref.store %o2, %rq[%hi] : memref<256xf32>
         }
         scf.for %d = %c0 to %ch2 step %c1 {
           %i1 = arith.addi %hb, %d : index
           %dh = arith.addi %d, %ch2 : index
           %i2 = arith.addi %hb, %dh : index
           %v1 = memref.load %rq[%i1] : memref<256xf32>
           %v2 = memref.load %rq[%i2] : memref<256xf32>
           %cs = memref.load %RO[%pos, %d] : memref<38x64xf32>
           %dsin = arith.addi %d, %chd : index
           %sn = memref.load %RO[%pos, %dsin] : memref<38x64xf32>
           %a1 = arith.mulf %v1, %cs : f32
           %b1 = arith.mulf %v2, %sn : f32
           %o1 = arith.subf %a1, %b1 : f32
           %a2 = arith.mulf %v2, %cs : f32
           %b2 = arith.mulf %v1, %sn : f32
           %o2 = arith.addf %a2, %b2 : f32
           memref.store %o1, %rq[%i1] : memref<256xf32>
           memref.store %o2, %rq[%i2] : memref<256xf32>
         }
       }
       // k heads: same, then appended to the cache. v is appended unchanged.
       scf.for %hk = %c0 to %ckvh step %c1 {
         %kb0 = arith.muli %cheads, %chd : index
         %khb = arith.muli %hk, %chd : index
         %kb = arith.addi %kb0, %khb : index
         %ks = scf.for %d = %c0 to %chd step %c1
             iter_args(%s = %fzero) -> (f32) {
           %hi = arith.addi %kb, %d : index
           %v = memref.load %rq[%hi] : memref<256xf32>
           %sq2 = arith.mulf %v, %v : f32
           %s2 = arith.addf %s, %sq2 : f32
           scf.yield %s2 : f32
         }
         %km = arith.divf %ks, %fhd : f32
         %km2 = arith.addf %km, %eps : f32
         %kr = math.sqrt %km2 : f32
         scf.for %d = %c0 to %chd step %c1 {
           %hi = arith.addi %kb, %d : index
           %v = memref.load %rq[%hi] : memref<256xf32>
           %nv = arith.divf %v, %kr : f32
           %dk = arith.addi %d, %chd : index
           %nw = memref.load %QKN[%l, %dk] : memref<2x64xf32>
           %o2 = arith.mulf %nv, %nw : f32
           memref.store %o2, %rq[%hi] : memref<256xf32>
         }
         scf.for %d = %c0 to %ch2 step %c1 {
           %i1 = arith.addi %kb, %d : index
           %dh = arith.addi %d, %ch2 : index
           %i2 = arith.addi %kb, %dh : index
           %v1 = memref.load %rq[%i1] : memref<256xf32>
           %v2 = memref.load %rq[%i2] : memref<256xf32>
           %cs = memref.load %RO[%pos, %d] : memref<38x64xf32>
           %dsin = arith.addi %d, %chd : index
           %sn = memref.load %RO[%pos, %dsin] : memref<38x64xf32>
           %a1 = arith.mulf %v1, %cs : f32
           %b1 = arith.mulf %v2, %sn : f32
           %o1 = arith.subf %a1, %b1 : f32
           %a2 = arith.mulf %v2, %cs : f32
           %b2 = arith.mulf %v1, %sn : f32
           %o2 = arith.addf %a2, %b2 : f32
           memref.store %o1, %rq[%i1] : memref<256xf32>
           memref.store %o2, %rq[%i2] : memref<256xf32>
         }
         %vb0 = arith.addi %cheads, %ckvh : index
         %vb1 = arith.muli %vb0, %chd : index
         %vb = arith.addi %vb1, %khb : index
         scf.for %d = %c0 to %chd step %c1 {
           %ki = arith.addi %kb, %d : index
           %kv = memref.load %rq[%ki] : memref<256xf32>
           memref.store %kv, %Kc[%l, %pos, %hk, %d] : memref<2x38x2x32xf32>
           %vi = arith.addi %vb, %d : index
           %vv = memref.load %rq[%vi] : memref<256xf32>
           memref.store %vv, %Vc[%l, %pos, %hk, %d] : memref<2x38x2x32xf32>
         }
       }
       // keep q for the attention pass below
       scf.for %h = %c0 to %cheads step %c1 {
         %hb = arith.muli %h, %chd : index
         scf.for %d = %c0 to %chd step %c1 {
           %hi = arith.addi %hb, %d : index
           %v = memref.load %rq[%hi] : memref<256xf32>
           %oi = arith.addi %hb, %d : index
           memref.store %v, %QKV[%m, %oi] : memref<2x256xf32>
         }
       }
      }
      // 3 onwards, now that every token has appended
      scf.for %m = %c0 to %nat step %c1 {
       %pos = arith.addi %wbase, %m : index
       scf.for %h = %c0 to %cheads step %c1 {
         %hb = arith.muli %h, %chd : index
         %hk = arith.divui %h, %cgroup : index
         %mxs = scf.for %t = %c0 to %curlen step %c1
             iter_args(%mv = %negbig) -> (f32) {
           %dot = scf.for %d = %c0 to %chd step %c1
               iter_args(%s = %fzero) -> (f32) {
             %hi = arith.addi %hb, %d : index
             %qv = memref.load %QKV[%m, %hi] : memref<2x256xf32>
             %kv = memref.load %Kc[%l, %t, %hk, %d] : memref<2x38x2x32xf32>
             %mu = arith.mulf %qv, %kv : f32
             %s2 = arith.addf %s, %mu : f32
             scf.yield %s2 : f32
           }
           %scv = arith.mulf %dot, %invsqrthd : f32
           // causal over the window: token m sees the prefix and the window
           // entries up to and including its own
           %ok = arith.cmpi ule, %t, %pos : index
           %scm = arith.select %ok, %scv, %negbig : f32
           memref.store %scm, %rsc[%t] : memref<38xf32>
           %m2 = arith.maxnumf %mv, %scm : f32
           scf.yield %m2 : f32
         }
         %sum = scf.for %t = %c0 to %curlen step %c1
             iter_args(%sm = %fzero) -> (f32) {
           %v = memref.load %rsc[%t] : memref<38xf32>
           %d = arith.subf %v, %mxs : f32
           %e = math.exp %d : f32
           memref.store %e, %rsc[%t] : memref<38xf32>
           %s2 = arith.addf %sm, %e : f32
           scf.yield %s2 : f32
         }
         scf.for %d = %c0 to %chd step %c1 {
           %acc = scf.for %t = %c0 to %curlen step %c1
               iter_args(%s = %fzero) -> (f32) {
             %e = memref.load %rsc[%t] : memref<38xf32>
             %pv = arith.divf %e, %sum : f32
             %vv = memref.load %Vc[%l, %t, %hk, %d] : memref<2x38x2x32xf32>
             %mu = arith.mulf %pv, %vv : f32
             %s2 = arith.addf %s, %mu : f32
             scf.yield %s2 : f32
           }
           %oi = arith.addi %hb, %d : index
           memref.store %acc, %ra[%oi] : memref<128xf32>
         }
       }
       // 4: ao = a @ Wo
       scf.for %j = %c0 to %cdim step %c1 {
         %acc = scf.for %i = %c0 to %cqw step %c1
             iter_args(%s = %fzero) -> (f32) {
           %av = memref.load %ra[%i] : memref<128xf32>
           %wv = memref.load %Wo[%l, %i, %j] : memref<2x128x128xf32>
           %mu = arith.mulf %av, %wv : f32
           %s2 = arith.addf %s, %mu : f32
           scf.yield %s2 : f32
         }
         memref.store %acc, %rao[%j] : memref<128xf32>
       }
       // 5: the residual around attention, then the norm the MLP reads. The
       // residual that stage 8 closes is the *unnormalised* one: a decoder
       // layer normalises what the MLP sees and leaves the stream alone.
       %ssa = scf.for %j = %c0 to %cdim step %c1
           iter_args(%s = %fzero) -> (f32) {
         %xv = memref.load %ref[%m, %j] : memref<2x128xf32>
         %av = memref.load %rao[%j] : memref<128xf32>
         %xa = arith.addf %xv, %av : f32
         memref.store %xa, %rxr[%j] : memref<128xf32>
         %sqa = arith.mulf %xa, %xa : f32
         %s2 = arith.addf %s, %sqa : f32
         scf.yield %s2 : f32
       }
       %meana = arith.divf %ssa, %fdim : f32
       %mea = arith.addf %meana, %eps : f32
       %rmsa = math.sqrt %mea : f32
       scf.for %j = %c0 to %cdim step %c1 {
         %xv = memref.load %rxr[%j] : memref<128xf32>
         %nv = arith.divf %xv, %rmsa : f32
         %nw = memref.load %N2[%l, %j] : memref<2x128xf32>
         %xn = arith.mulf %nv, %nw : f32
         memref.store %xn, %rxa[%j] : memref<128xf32>
       }
       // 6: gu = xa @ Wgu
       scf.for %p = %c0 to %c2inter step %c1 {
         %acc = scf.for %i = %c0 to %cdim step %c1
             iter_args(%s = %fzero) -> (f32) {
           %xv = memref.load %rxa[%i] : memref<128xf32>
           %wv = memref.load %Wgu[%l, %i, %p] : memref<2x128x512xf32>
           %mu = arith.mulf %xv, %wv : f32
           %s2 = arith.addf %s, %mu : f32
           scf.yield %s2 : f32
         }
         memref.store %acc, %rgu[%p] : memref<512xf32>
       }
       // 7: act = silu(gate) * up
       scf.for %p = %c0 to %cinter step %c1 {
         %gv = memref.load %rgu[%p] : memref<512xf32>
         %pu = arith.addi %p, %cinter : index
         %uv = memref.load %rgu[%pu] : memref<512xf32>
         %ng = arith.negf %gv : f32
         %eg = math.exp %ng : f32
         %de = arith.addf %fone, %eg : f32
         %si = arith.divf %gv, %de : f32
         %av = arith.mulf %si, %uv : f32
         memref.store %av, %ract[%p] : memref<256xf32>
       }
       // 8: x = xa + act @ Wd
       scf.for %j = %c0 to %cdim step %c1 {
         %acc = scf.for %p = %c0 to %cinter step %c1
             iter_args(%s = %fzero) -> (f32) {
           %av = memref.load %ract[%p] : memref<256xf32>
           %wv = memref.load %Wd[%l, %p, %j] : memref<2x256x128xf32>
           %mu = arith.mulf %av, %wv : f32
           %s2 = arith.addf %s, %mu : f32
           scf.yield %s2 : f32
         }
         %xv = memref.load %rxr[%j] : memref<128xf32>
         %nx = arith.addf %xv, %acc : f32
         memref.store %nx, %ref[%m, %j] : memref<2x128xf32>
       }
      }
     }
     // final norm, lm head, then argmax the way Fleet does it: a partial per
     // piece, then a reduce over the pieces
     scf.for %m = %c0 to %nat step %c1 {
       %fs = scf.for %i = %c0 to %cdim step %c1
           iter_args(%a = %fzero) -> (f32) {
         %v = memref.load %ref[%m, %i] : memref<2x128xf32>
         %q = arith.mulf %v, %v : f32
         %a2 = arith.addf %a, %q : f32
         scf.yield %a2 : f32
       }
       %fm = arith.divf %fs, %fdim : f32
       %fme = arith.addf %fm, %eps : f32
       %fr = math.sqrt %fme : f32
       scf.for %i = %c0 to %cdim step %c1 {
         %v = memref.load %ref[%m, %i] : memref<2x128xf32>
         %nv = arith.divf %v, %fr : f32
         %nw = memref.load %Nf[%i] : memref<128xf32>
         %o = arith.mulf %nv, %nw : f32
         memref.store %o, %Xf[%m, %i] : memref<2x128xf32>
       }
       scf.for %v = %c0 to %cvocab step %c1 {
         %acc = scf.for %i = %c0 to %cdim step %c1
             iter_args(%a = %fzero) -> (f32) {
           %xv = memref.load %Xf[%m, %i] : memref<2x128xf32>
           %wv = memref.load %Wlm[%i, %v] : memref<128x256xf32>
           %mu = arith.mulf %xv, %wv : f32
           %a2 = arith.addf %a, %mu : f32
           scf.yield %a2 : f32
         }
         memref.store %acc, %Lg[%m, %v] : memref<2x256xf32>
       }
       // partial: best in each piece
       scf.for %k = %c0 to %ctasks_h step %c1 {
         %v0 = arith.muli %k, %csliceVh : index
         %bi:2 = scf.for %jj = %c0 to %csliceVh step %c1
             iter_args(%bv = %negbig, %bx = %zero) -> (f32, i32) {
           %v = arith.addi %v0, %jj : index
           %lv = memref.load %Lg[%m, %v] : memref<2x256xf32>
           %gt = arith.cmpf ogt, %lv, %bv : f32
           %nv2 = arith.select %gt, %lv, %bv : f32
           %vi = arith.index_cast %v : index to i32
           %nx = arith.select %gt, %vi, %bx : i32
           scf.yield %nv2, %nx : f32, i32
         }
         memref.store %bi#0, %PV[%m, %k] : memref<2x8xf32>
         memref.store %bi#1, %PI[%m, %k] : memref<2x8xi32>
       }
       // reduce: best across pieces, ties to the lower vocabulary index
       %rd:2 = scf.for %k = %c0 to %ctasks_h step %c1
           iter_args(%bv = %negbig, %bx = %zero) -> (f32, i32) {
         %pv = memref.load %PV[%m, %k] : memref<2x8xf32>
         %pi = memref.load %PI[%m, %k] : memref<2x8xi32>
         %gt = arith.cmpf ogt, %pv, %bv : f32
         %nv2 = arith.select %gt, %pv, %bv : f32
         %nx = arith.select %gt, %pi, %bx : i32
         scf.yield %nv2, %nx : f32, i32
       }
       // A sequence has one next token: the argmax of its last position. The
       // earlier rows of a prefill chunk predict tokens the prompt already
       // supplies, and Fleet drops those too -- it only copies an output token
       // back into the stream when the slot is at or past the prompt
       // (persistent_kernel.cuh:396).
       %lastm = arith.subi %nat, %c1 : index
       %isLastRow = arith.cmpi eq, %m, %lastm : index
       scf.if %isLastRow {
         %nxt = arith.addi %seq, %nat : index
         %past = arith.cmpi sge, %nxt, %cplen : index
         scf.if %past {
           memref.store %rd#1, %Tok[%nxt] : memref<7xi32>
         }
       }
     }
     %seqn = arith.addi %seq, %nat : index
     scf.yield %seqn : index
    }
    // The reference used these as scratch; hand the device zeroed copies.
    scf.for %m = %c0 to %ctok step %c1 {
      scf.for %i = %c0 to %cdim step %c1 {
        memref.store %fzero, %Rv[%m, %i] : memref<2x128xf32>
      }
      scf.for %i = %c0 to %cqkvo step %c1 {
        memref.store %fzero, %QKV[%m, %i] : memref<2x256xf32>
      }
      scf.for %i = %c0 to %cqw step %c1 {
        memref.store %fzero, %Av[%m, %i] : memref<2x128xf32>
      }
    }
    // The reference appended its own k and v; the device must start from a
    // cache holding only the prefix.
    scf.for %l = %c0 to %clayers step %c1 {
      scf.for %t = %c0 to %cwin step %c1 {
        %tp = arith.addi %cpre, %t : index
        scf.for %hk = %c0 to %ckvh step %c1 {
          scf.for %d = %c0 to %chd step %c1 {
            memref.store %fzero, %Kc[%l, %tp, %hk, %d] : memref<2x38x2x32xf32>
            memref.store %fzero, %Vc[%l, %tp, %hk, %d] : memref<2x38x2x32xf32>
          }
        }
      }
    }

    %Q = memref.alloc() : memref<3x2x224xi32>
    %cq = arith.constant 224 : index
    scf.for %sp = %c0 to %csteps step %c1 {
      scf.for %l = %c0 to %clayers step %c1 {
        scf.for %k = %c0 to %cq step %c1 {
          memref.store %zero, %Q[%sp, %l, %k] : memref<3x2x224xi32>
        }
      }
    }
    // Two-level event counting (persistent_kernel.cuh:1226-1251): workers add
    // into a counter only their own die touches, and the last one out flushes
    // the die's whole share to the device counter.
    %Loc = memref.alloc() : memref<2209xi32>
    %cloc = arith.constant 2209 : index
    scf.for %i = %c0 to %cloc step %c1 {
      memref.store %zero, %Loc[%i] : memref<2209xi32>
    }
    %E = memref.alloc() : memref<69xi32>
    %ce = arith.constant 69 : index
    scf.for %i = %c0 to %ce step %c1 {
      memref.store %zero, %E[%i] : memref<69xi32>
    }

    %dX = gpu.alloc () : memref<2x128xf32>
    %dRv = gpu.alloc () : memref<2x128xf32>
    %dQKV = gpu.alloc () : memref<2x256xf32>
    %dSc = gpu.alloc () : memref<2x4x38xf32>
    %dAv = gpu.alloc () : memref<2x128xf32>
    %dAov = gpu.alloc () : memref<2x128xf32>
    %dXa = gpu.alloc () : memref<2x128xf32>
    %dGU = gpu.alloc () : memref<2x512xf32>
    %dActv = gpu.alloc () : memref<2x256xf32>
    %dWqkv = gpu.alloc () : memref<2x128x256xf32>
    %dWo = gpu.alloc () : memref<2x128x128xf32>
    %dWgu = gpu.alloc () : memref<2x128x512xf32>
    %dWd = gpu.alloc () : memref<2x256x128xf32>
    %dKc = gpu.alloc () : memref<2x38x2x32xf32>
    %dVc = gpu.alloc () : memref<2x38x2x32xf32>
    %dN1 = gpu.alloc () : memref<2x128xf32>
    %dN2 = gpu.alloc () : memref<2x128xf32>
    %dQKN = gpu.alloc () : memref<2x64xf32>
    %dRO = gpu.alloc () : memref<38x64xf32>
    %dEmb = gpu.alloc () : memref<256x128xf32>
    %dWlm = gpu.alloc () : memref<128x256xf32>
    %dNf = gpu.alloc () : memref<128xf32>
    %dTok = gpu.alloc () : memref<7xi32>
    %dLg = gpu.alloc () : memref<2x256xf32>
    %dPV = gpu.alloc () : memref<2x8xf32>
    %dPI = gpu.alloc () : memref<2x8xi32>
    %dQ = gpu.alloc () : memref<3x2x224xi32>
    %dLoc = gpu.alloc () : memref<2209xi32>
    %dE = gpu.alloc () : memref<69xi32>
    %dPlen = gpu.alloc () : memref<1xi32>
    gpu.memcpy %dPlen, %Plen : memref<1xi32>, memref<1xi32>
    gpu.memcpy %dX, %X : memref<2x128xf32>, memref<2x128xf32>
    gpu.memcpy %dRv, %Rv : memref<2x128xf32>, memref<2x128xf32>
    gpu.memcpy %dQKV, %QKV : memref<2x256xf32>, memref<2x256xf32>
    gpu.memcpy %dSc, %Sc : memref<2x4x38xf32>, memref<2x4x38xf32>
    gpu.memcpy %dAv, %Av : memref<2x128xf32>, memref<2x128xf32>
    gpu.memcpy %dAov, %Aov : memref<2x128xf32>, memref<2x128xf32>
    gpu.memcpy %dXa, %Xa : memref<2x128xf32>, memref<2x128xf32>
    gpu.memcpy %dGU, %GU : memref<2x512xf32>, memref<2x512xf32>
    gpu.memcpy %dActv, %Actv : memref<2x256xf32>, memref<2x256xf32>
    gpu.memcpy %dWqkv, %Wqkv : memref<2x128x256xf32>, memref<2x128x256xf32>
    gpu.memcpy %dWo, %Wo : memref<2x128x128xf32>, memref<2x128x128xf32>
    gpu.memcpy %dWgu, %Wgu : memref<2x128x512xf32>, memref<2x128x512xf32>
    gpu.memcpy %dWd, %Wd : memref<2x256x128xf32>, memref<2x256x128xf32>
    gpu.memcpy %dKc, %Kc : memref<2x38x2x32xf32>, memref<2x38x2x32xf32>
    gpu.memcpy %dVc, %Vc : memref<2x38x2x32xf32>, memref<2x38x2x32xf32>
    gpu.memcpy %dN1, %N1 : memref<2x128xf32>, memref<2x128xf32>
    gpu.memcpy %dN2, %N2 : memref<2x128xf32>, memref<2x128xf32>
    gpu.memcpy %dQKN, %QKN : memref<2x64xf32>, memref<2x64xf32>
    gpu.memcpy %dRO, %RO : memref<38x64xf32>, memref<38x64xf32>
    gpu.memcpy %dEmb, %Emb : memref<256x128xf32>, memref<256x128xf32>
    gpu.memcpy %dWlm, %Wlm : memref<128x256xf32>, memref<128x256xf32>
    gpu.memcpy %dNf, %Nf : memref<128xf32>, memref<128xf32>
    gpu.memcpy %dLg, %Lg : memref<2x256xf32>, memref<2x256xf32>
    gpu.memcpy %dPV, %PV : memref<2x8xf32>, memref<2x8xf32>
    gpu.memcpy %dPI, %PI : memref<2x8xi32>, memref<2x8xi32>
    gpu.memcpy %dQ, %Q : memref<3x2x224xi32>, memref<3x2x224xi32>
    gpu.memcpy %dLoc, %Loc : memref<2209xi32>, memref<2209xi32>
    gpu.memcpy %dE, %E : memref<69xi32>, memref<69xi32>

    // --repeat runs the chain more than once so an external clock has
    // something to measure. Timing it from inside with mgpuEventRecord does not
    // work: the events go on the stream created here, while gpu-to-llvm puts
    // the kernel on one of its own, so mgpuEventElapsedTime returns
    // hipErrorInvalidHandle. The 4k GEMM test has the same problem.
    %crep = arith.constant 1 : index
    scf.for %rep = %c0 to %crep step %c1 {
      scf.for %sp = %c0 to %csteps step %c1 {
        scf.for %l = %c0 to %clayers step %c1 {
          scf.for %k = %c0 to %cq step %c1 {
            memref.store %zero, %Q[%sp, %l, %k] : memref<3x2x224xi32>
          }
        }
      }
      scf.for %i = %c0 to %ce step %c1 {
        memref.store %zero, %E[%i] : memref<69xi32>
      }
      scf.for %i = %c0 to %cloc step %c1 {
        memref.store %zero, %Loc[%i] : memref<2209xi32>
      }
      gpu.memcpy %dQ, %Q : memref<3x2x224xi32>, memref<3x2x224xi32>
      gpu.memcpy %dLoc, %Loc : memref<2209xi32>, memref<2209xi32>
      gpu.memcpy %dE, %E : memref<69xi32>, memref<69xi32>
      // The chain rewrites x in place, and each token always writes the same
      // cache slot, so only x has to be restored.
      // Only the prompt is restored: the chain embeds it, and every later
      // token is produced on the device.
      scf.for %m = %c0 to %cmaxseq step %c1 {
        %keep = arith.cmpi ult, %m, %cplen : index
        %cur = memref.load %Tok[%m] : memref<7xi32>
        %nv = arith.select %keep, %cur, %zero : i32
        memref.store %nv, %Tok0[%m] : memref<7xi32>
      }
      gpu.memcpy %dTok, %Tok0 : memref<7xi32>, memref<7xi32>
      func.call @chain(%dQ, %dE, %dX, %dRv, %dQKV, %dSc, %dAv, %dAov, %dXa,
                       %dGU, %dActv, %dWqkv, %dWo, %dWgu, %dWd, %dKc, %dVc,
                       %dN1, %dN2, %dQKN, %dRO, %dEmb, %dWlm, %dNf, %dTok,
                       %dLg, %dPV, %dPI, %dLoc, %dPlen)
        : (memref<3x2x224xi32>, memref<69xi32>, memref<2x128xf32>, memref<2x128xf32>,
           memref<2x256xf32>, memref<2x4x38xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x512xf32>, memref<2x256xf32>,
           memref<2x128x256xf32>, memref<2x128x128xf32>, memref<2x128x512xf32>, memref<2x256x128xf32>, memref<2x38x2x32xf32>, memref<2x38x2x32xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x64xf32>, memref<38x64xf32>,
           memref<256x128xf32>, memref<128x256xf32>, memref<128xf32>, memref<7xi32>, memref<2x256xf32>, memref<2x8xf32>, memref<2x8xi32>,
           memref<2209xi32>, memref<1xi32>) -> ()
    }

    gpu.memcpy %X, %dX : memref<2x128xf32>, memref<2x128xf32>

    %tol = arith.constant 2.0e-2 : f32
    %bad = scf.for %m = %c0 to %ctok step %c1
        iter_args(%bo = %zero) -> (i32) {
      %bi = scf.for %i = %c0 to %cdim step %c1
          iter_args(%b = %bo) -> (i32) {
        %got = memref.load %X[%m, %i] : memref<2x128xf32>
        %want = memref.load %ref[%m, %i] : memref<2x128xf32>
        %d = arith.subf %got, %want : f32
        %ad = math.absf %d : f32
        %aw = math.absf %want : f32
        %sc = arith.maxnumf %aw, %fone : f32
        %rel = arith.divf %ad, %sc : f32
        %ok = arith.cmpf ole, %rel, %tol : f32
        %inc = arith.select %ok, %zero, %one : i32
        %b2 = arith.addi %b, %inc : i32
        scf.yield %b2 : i32
      }
      scf.yield %bi : i32
    }
    vector.print str "layers = "
    %nl = arith.constant 2 : i32
    vector.print %nl : i32
    vector.print str "tokens = "
    %ntk = arith.constant 2 : i32
    vector.print %ntk : i32
    vector.print str "steps = "
    %nst = arith.constant 3 : i32
    vector.print %nst : i32
    vector.print str "query heads = "
    %nh = arith.constant 4 : i32
    vector.print %nh : i32
    gpu.memcpy %Loc, %dLoc : memref<2209xi32>, memref<2209xi32>
    %cflush = arith.constant 2208 : index
    %flushes = memref.load %Loc[%cflush] : memref<2209xi32>
    vector.print str "device-scope event flushes = "
    vector.print %flushes : i32
    %cnaive = arith.constant 1632 : i32
    vector.print str "what signalling per worker would have been = "
    vector.print %cnaive : i32
    vector.print str "output elements differing from the reference = "
    vector.print %bad : i32
    // The token check is exact, not a tolerance: argmax turns the whole chain
    // into a discrete answer, so a token either matches or it does not.
    gpu.memcpy %Tok0, %dTok : memref<7xi32>, memref<7xi32>
    // Only the generated tail is compared: the prompt was handed to both sides.
    %tbad = scf.for %m = %cplen to %cmaxseq step %c1
        iter_args(%b = %zero) -> (i32) {
      %g = memref.load %Tok0[%m] : memref<7xi32>
      %wt = memref.load %Tok[%m] : memref<7xi32>
      %eq = arith.cmpi eq, %g, %wt : i32
      %inc = arith.select %eq, %zero, %one : i32
      %b2 = arith.addi %b, %inc : i32
      scf.yield %b2 : i32
    }
    // The logits are where the vocabulary tail is actually checked. The token
    // on top of them is a much blunter instrument: this chain is contractive,
    // the hidden state varies by tens of percent between steps, and argmax over
    // a vocabulary needs more than that to move -- so a token can match while
    // the logits under it are wrong. The float comparison catches that; the
    // token comparison catches the argmax stages on top.
    gpu.memcpy %LgD, %dLg : memref<2x256xf32>, memref<2x256xf32>
    %lbad = scf.for %m = %c0 to %ctok step %c1
        iter_args(%bo = %zero) -> (i32) {
      %bi = scf.for %v = %c0 to %cvocab step %c1
          iter_args(%b = %bo) -> (i32) {
        %g = memref.load %LgD[%m, %v] : memref<2x256xf32>
        %wv = memref.load %Lg[%m, %v] : memref<2x256xf32>
        %d = arith.subf %g, %wv : f32
        %ad = math.absf %d : f32
        %aw = math.absf %wv : f32
        %scl = arith.maxnumf %aw, %fone : f32
        %rel = arith.divf %ad, %scl : f32
        %ok = arith.cmpf ole, %rel, %tol : f32
        %inc = arith.select %ok, %zero, %one : i32
        %b2 = arith.addi %b, %inc : i32
        scf.yield %b2 : i32
      }
      scf.yield %bi : i32
    }
    vector.print str "logit elements differing from the reference = "
    vector.print %lbad : i32
    // Print the reference token ids so an outside model can check them: the
    // device agreeing with the host reference only proves they match.
    vector.print str "reference tokens:"
    scf.for %m = %cplen to %cmaxseq step %c1 {
      %tv = memref.load %Tok[%m] : memref<7xi32>
      vector.print %tv : i32
    }
    vector.print str "tokens differing from the reference = "
    vector.print %tbad : i32
    %tot0 = arith.addi %bad, %tbad : i32
    %tot = arith.addi %tot0, %lbad : i32
    vector.print str "total differences = "
    vector.print %tot : i32
    return
  }

  func.func @chain(%Q: memref<3x2x224xi32>, %E: memref<69xi32>,
                   %X: memref<2x128xf32>, %Rv: memref<2x128xf32>, %QKV: memref<2x256xf32>, %Sc: memref<2x4x38xf32>,
                   %Av: memref<2x128xf32>, %Aov: memref<2x128xf32>, %Xa: memref<2x128xf32>, %GU: memref<2x512xf32>, %Actv: memref<2x256xf32>,
                   %Wqkv: memref<2x128x256xf32>, %Wo: memref<2x128x128xf32>, %Wgu: memref<2x128x512xf32>, %Wd: memref<2x256x128xf32>,
                   %Kc: memref<2x38x2x32xf32>, %Vc: memref<2x38x2x32xf32>, %N1: memref<2x128xf32>, %N2: memref<2x128xf32>,
                   %QKN: memref<2x64xf32>, %RO: memref<38x64xf32>, %Emb: memref<256x128xf32>, %Wlm: memref<128x256xf32>,
                   %Nf: memref<128xf32>, %Tok: memref<7xi32>, %Lg: memref<2x256xf32>, %PV: memref<2x8xf32>,
                   %PI: memref<2x8xi32>, %Loc: memref<2209xi32>, %Pl: memref<1xi32>) {
    %c1 = arith.constant 1 : index
    %cw = arith.constant 32 : index
    air.launch (%bx, %by) in (%nbx=%cw, %nby=%c1)
        args(%q=%Q, %eb=%E, %x=%X, %r=%Rv, %qkv=%QKV, %scb=%Sc, %av=%Av,
             %aov=%Aov, %xab=%Xa, %gub=%GU, %actb=%Actv, %wqkv=%Wqkv,
             %wo=%Wo, %wgu=%Wgu, %wd=%Wd, %kc=%Kc, %vc=%Vc, %n1=%N1,
             %n2=%N2, %qkn=%QKN, %ro=%RO, %emb=%Emb, %wlm=%Wlm, %nf=%Nf,
             %tok=%Tok, %lg=%Lg, %pvb=%PV, %pib=%PI, %loc=%Loc, %plb=%Pl)
        : memref<3x2x224xi32>, memref<69xi32>, memref<2x128xf32>, memref<2x128xf32>,
          memref<2x256xf32>, memref<2x4x38xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x512xf32>, memref<2x256xf32>,
          memref<2x128x256xf32>, memref<2x128x128xf32>, memref<2x128x512xf32>, memref<2x256x128xf32>, memref<2x38x2x32xf32>, memref<2x38x2x32xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x64xf32>, memref<38x64xf32>,
          memref<256x128xf32>, memref<128x256xf32>, memref<128xf32>, memref<7xi32>, memref<2x256xf32>, memref<2x8xf32>, memref<2x8xi32>,
          memref<2209xi32>, memref<1xi32> {
      air.segment @worker args(%sq=%q, %se=%eb, %sx=%x, %sr=%r, %sqkv=%qkv,
                               %ssc=%scb, %sav=%av, %saov=%aov, %sxa=%xab,
                               %sgu=%gub, %sact=%actb, %swqkv=%wqkv,
                               %swo=%wo, %swgu=%wgu, %swd=%wd, %skc=%kc,
                               %svc=%vc, %sn1=%n1, %sn2=%n2, %sqkn=%qkn,
                               %sro=%ro, %semb=%emb, %swlm=%wlm, %snf=%nf,
                               %stok=%tok, %slg=%lg, %spv=%pvb, %spi=%pib,
                               %sloc=%loc, %splen=%plb)
          : memref<3x2x224xi32>, memref<69xi32>, memref<2x128xf32>, memref<2x128xf32>,
            memref<2x256xf32>, memref<2x4x38xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x512xf32>, memref<2x256xf32>,
            memref<2x128x256xf32>, memref<2x128x128xf32>, memref<2x128x512xf32>, memref<2x256x128xf32>, memref<2x38x2x32xf32>, memref<2x38x2x32xf32>, memref<2x128xf32>, memref<2x128xf32>, memref<2x64xf32>, memref<38x64xf32>,
            memref<256x128xf32>, memref<128x256xf32>, memref<128xf32>, memref<7xi32>, memref<2x256xf32>, memref<2x8xf32>, memref<2x8xi32>,
            memref<2209xi32>, memref<1xi32> {
        %c0_s = arith.constant 0 : index
        %c1_s = arith.constant 1 : index
        %ctasks = arith.constant 8 : index
        %csliceD = arith.constant 16 : index
        %csliceI = arith.constant 32 : index
        %cslice2I = arith.constant 64 : index
        %csliceQ = arith.constant 32 : index
        %cdim_s = arith.constant 128 : index
        %cinter_s = arith.constant 256 : index
        %chd_s = arith.constant 32 : index
        %ch2_s = arith.constant 16 : index
        %cheads_s = arith.constant 4 : index
        %ckvh_s = arith.constant 2 : index
        %cgroup_s = arith.constant 2 : index
        %cpre_s = arith.constant 32 : index
        %ctotal_s = arith.constant 38 : index
        %csteps_s = arith.constant 3 : index
        %cevstep = arith.constant 92 : i64
        %clocstep = arith.constant 1472 : i64
        %cvocab_s = arith.constant 256 : index
        %csliceV = arith.constant 32 : index
        %negbigI = arith.constant -2147483648 : i32
        %cqw_s = arith.constant 128 : index
        %ckbase = arith.constant 128 : index
        %cvbase = arith.constant 192 : index
        %one_s = arith.constant 1 : i32
        %zero_s = arith.constant 0 : i32
        %ctok_s = arith.constant 2 : index
        // A stage's pieces are the (token, n) grid, so the event it signals
        // counts tokens * n.
        %ntasks_t = arith.constant 16 : i32
        %nheads_t = arith.constant 8 : i32
        %n1_s = arith.constant 1 : i32
        %fzero_s = arith.constant 0.0 : f32
        %fone_s = arith.constant 1.0 : f32
        %eps_s = arith.constant 1.0e-6 : f32
        %fdim_s = arith.constant 1.280000e+02 : f32
        %fhd_s = arith.constant 3.200000e+01 : f32
        %invsqrthd_s = arith.constant 1.76776695e-01 : f32
        %negbig_s = arith.constant -1.000000e30 : f32
        %true = arith.constant true

        %tx_s = gpu.thread_id x
        %ty_s = gpu.thread_id y
        %tz_s = gpu.thread_id z
        %t01 = arith.ori %tx_s, %ty_s : index
        %t012 = arith.ori %t01, %tz_s : index
        %isLead = arith.cmpi eq, %t012, %c0_s : index
        // Which die this workgroup is on. Work is claimed per die so that the
        // slices a die computes are the ones its own cache is holding.
        %mydie_raw = air.chiplet_id
        %cmaxdies = arith.constant 16 : index
        %mydie = arith.remui %mydie_raw, %cmaxdies : index
        %L0 = arith.constant 0 : index
        %L1 = arith.constant 1 : index
        %locbase = memref.extract_aligned_pointer_as_index %sloc : memref<2209xi32> -> index
        %locbi = arith.index_cast %locbase : index to i64
        %locp = llvm.inttoptr %locbi : i64 to !llvm.ptr
        %fourL = arith.constant 4 : i64
        %cflushW = arith.constant 8832 : i64
        %flushP = llvm.getelementptr %locp[%cflushW] : (!llvm.ptr, i64) -> !llvm.ptr, i8
        %myrank2 = air.chiplet_block_id
        %mycnt = air.chiplet_dim_blocks
        %mycnt_i = arith.index_cast %mycnt : index to i32
        %evbase = memref.extract_aligned_pointer_as_index %se : memref<69xi32> -> index
        %evi = arith.index_cast %evbase : index to i64
        %evptr = llvm.inttoptr %evi : i64 to !llvm.ptr

        scf.if %isLead {
          // One launch runs the whole decode. The task graph is the same every
          // step; what changes is the iteration it belongs to. Fleet versions
          // task identity the same way -- TaskId is
          // (iteration_num << 32) | position_index
          // (persistent_kernel.cuh:263) -- so a step gets fresh event and queue
          // slots without anything having to be reset between steps.
          %seqend = scf.for %step = %c0_s to %csteps_s step %c1_s
              iter_args(%seq = %c0_s) -> (index) {
            %stepi = arith.index_cast %step : index to i64
            %stepev = arith.muli %stepi, %cevstep : i64
            %steploc = arith.muli %stepi, %clocstep : i64
            // How many tokens this step actually carries. It is read from a
            // buffer, not folded from %step, because that is the whole point:
            // one static task graph serves a prefill chunk of `tokens` and a
            // decode step of 1, exactly as Fleet's does -- prepare_next_batch
            // writes qo_indptr_buffer on the device and the tasks read their
            // trip counts out of it (persistent_kernel.cuh:441-450,
            // multitoken_paged_attention_mfma_mi300.cuh:78-83).
            %plv = memref.load %splen[%c0_s] : memref<1xi32>
            %plen_s = arith.index_cast %plv : i32 to index
            %rem_s = arith.subi %plen_s, %seq : index
            %isPre_s = arith.cmpi sgt, %rem_s, %c0_s : index
            %capped_s = arith.minsi %rem_s, %ctok_s : index
            %nat = arith.select %isPre_s, %capped_s, %c1_s : index
            %wbase = arith.addi %cpre_s, %seq : index
            %curlen = arith.addi %wbase, %nat : index
          // stage 9
          %ecx_9 = arith.constant 72 : i64
          %eox_9 = arith.addi %stepev, %ecx_9 : i64
          %px_9 = llvm.getelementptr %evptr[%eox_9] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hbx_9 = arith.constant 144 : index
          %tx_9 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hbx_9, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hidx] : (i32, memref<3x2x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
              // M fast, N slow: the token moves every claim, the weight block
              // only every `tokens` claims.
              %m = arith.remui %k, %ctok_s : index
              %kn = arith.divui %k, %ctok_s : index
              %kstride = arith.muli %kn, %cmaxdies : index
              %ix = arith.addi %d, %kstride : index
              %has = arith.cmpi ult, %ix, %ctasks : index
              // A piece whose token is past this step's active count is still
              // claimed and still counted -- the event totals are a property of
              // the task graph, which is static -- it just has nothing to do.
              // Fleet keeps the same static grid and passes num_active_tokens
              // down for the trip counts (gang_linear_mi300.cuh:51).
              %mAct = arith.cmpi ult, %m, %nat : index
              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %tp = arith.addi %seq, %m : index
                %tk = memref.load %stok[%tp] : memref<7xi32>
                %tki = arith.index_cast %tk : i32 to index
                %j0 = arith.muli %ix, %csliceD : index
                scf.for %jj = %c0_s to %csliceD step %c1_s {
                  %j = arith.addi %j0, %jj : index
                  %ev = memref.load %semb[%tki, %j] {nontemporal = true} : memref<256x128xf32>
                  memref.store %ev, %sx[%m, %j] : memref<2x128xf32>
                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lwx_9 = arith.constant 1152 : i64
          %mydx_9 = arith.index_cast %mydie : index to i64
          %myd4x_9 = arith.muli %mydx_9, %fourL : i64
          %lbx_9 = arith.addi %lwx_9, %myd4x_9 : i64
          %lox_9 = arith.addi %lbx_9, %steploc : i64
          %locPx_9 = llvm.getelementptr %locp[%lox_9] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %awx_9 = arith.constant 4416 : i64
          %aox_9 = arith.addi %awx_9, %lox_9 : i64
          %arrPx_9 = llvm.getelementptr %locp[%aox_9] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %lax_9 = llvm.atomicrmw add %locPx_9, %tx_9 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %arx_9 = llvm.atomicrmw add %arrPx_9, %one_s syncscope("agent") release : !llvm.ptr, i32
          %lastx_9 = arith.subi %mycnt_i, %one_s : i32
          %amLastx_9 = arith.cmpi eq, %arx_9, %lastx_9 : i32
          scf.if %amLastx_9 {
            %totx_9 = llvm.load %locPx_9 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sigx_9 = llvm.atomicrmw add %px_9, %totx_9 syncscope("") release : !llvm.ptr, i32
            %cntx_9 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %px_9 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %ntasks_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // ================= layer 0 =================
          // stage 0 -- one task: a reduction over the whole row, so it
          // cannot be split by output slice the way the matmuls can.
          %hsingle0_0 = arith.constant 0 : index
          %ec0_0 = arith.constant 0 : i64
          %eo0_0 = arith.addi %stepev, %ec0_0 : i64
          %p0_0 = llvm.getelementptr %evptr[%eo0_0] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %cl0_0 = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hsingle0_0] : (i32, memref<3x2x224xi32>) -> i32
          %mine0_0 = arith.cmpi eq, %cl0_0, %zero_s : i32
          scf.if %mine0_0 {
            scf.for %m = %c0_s to %nat step %c1_s {
              %ss0 = scf.for %i = %c0_s to %cdim_s step %c1_s
                  iter_args(%s = %fzero_s) -> (f32) {
                %v = memref.load %sx[%m, %i] : memref<2x128xf32>
                %sq2 = arith.mulf %v, %v : f32
                %s2 = arith.addf %s, %sq2 : f32
                scf.yield %s2 : f32
              }
              %mean0 = arith.divf %ss0, %fdim_s : f32
              %me0 = arith.addf %mean0, %eps_s : f32
              %rms0 = math.sqrt %me0 : f32
              scf.for %i = %c0_s to %cdim_s step %c1_s {
                %v = memref.load %sx[%m, %i] : memref<2x128xf32>
                %nv = arith.divf %v, %rms0 : f32
                %nw = memref.load %sn1[%L0, %i] : memref<2x128xf32>
                %rv = arith.mulf %nv, %nw : f32
                memref.store %rv, %sr[%m, %i] : memref<2x128xf32>
              }
            }
            %sig0_0 = llvm.atomicrmw add %p0_0, %n1_s syncscope("") release : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p0_0 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %n1_s : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 1
          %ec0_1 = arith.constant 4 : i64
          %eo0_1 = arith.addi %stepev, %ec0_1 : i64
          %p0_1 = llvm.getelementptr %evptr[%eo0_1] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hb0_1 = arith.constant 16 : index
          %t0_1 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hb0_1, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hidx] : (i32, memref<3x2x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
              // M fast, N slow: the token moves every claim, the weight block
              // only every `tokens` claims.
              %m = arith.remui %k, %ctok_s : index
              %kn = arith.divui %k, %ctok_s : index
              %kstride = arith.muli %kn, %cmaxdies : index
              %ix = arith.addi %d, %kstride : index
              %has = arith.cmpi ult, %ix, %ctasks : index
              // A piece whose token is past this step's active count is still
              // claimed and still counted -- the event totals are a property of
              // the task graph, which is static -- it just has nothing to do.
              // Fleet keeps the same static grid and passes num_active_tokens
              // down for the trip counts (gang_linear_mi300.cuh:51).
              %mAct = arith.cmpi ult, %m, %nat : index
              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %j0 = arith.muli %ix, %csliceQ : index
                scf.for %jj = %c0_s to %csliceQ step %c1_s {
                  %j = arith.addi %j0, %jj : index
                  %a = scf.for %i = %c0_s to %cdim_s step %c1_s
                      iter_args(%sacc = %fzero_s) -> (f32) {
                    %lv = memref.load %sr[%m, %i] : memref<2x128xf32>
                    %wv = memref.load %swqkv[%L0, %i, %j] {nontemporal = true} : memref<2x128x256xf32>
                    %mp = arith.mulf %lv, %wv : f32
                    %s2 = arith.addf %sacc, %mp : f32
                    scf.yield %s2 : f32
                  }
                  memref.store %a, %sqkv[%m, %j] : memref<2x256xf32>
                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw0_1 = arith.constant 64 : i64
          %myd0_1 = arith.index_cast %mydie : index to i64
          %myd40_1 = arith.muli %myd0_1, %fourL : i64
          %lb0_1 = arith.addi %lw0_1, %myd40_1 : i64
          %lo0_1 = arith.addi %lb0_1, %steploc : i64
          %locP0_1 = llvm.getelementptr %locp[%lo0_1] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw0_1 = arith.constant 4416 : i64
          %ao0_1 = arith.addi %aw0_1, %lo0_1 : i64
          %arrP0_1 = llvm.getelementptr %locp[%ao0_1] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la0_1 = llvm.atomicrmw add %locP0_1, %t0_1 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar0_1 = llvm.atomicrmw add %arrP0_1, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last0_1 = arith.subi %mycnt_i, %one_s : i32
          %amLast0_1 = arith.cmpi eq, %ar0_1, %last0_1 : i32
          scf.if %amLast0_1 {
            %tot0_1 = llvm.load %locP0_1 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig0_1 = llvm.atomicrmw add %p0_1, %tot0_1 syncscope("") release : !llvm.ptr, i32
            %cnt0_1 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p0_1 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %ntasks_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 2
          %ec0_2 = arith.constant 8 : i64
          %eo0_2 = arith.addi %stepev, %ec0_2 : i64
          %p0_2 = llvm.getelementptr %evptr[%eo0_2] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hb0_2 = arith.constant 32 : index
          %t0_2 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hb0_2, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hidx] : (i32, memref<3x2x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
              // M fast, N slow: the token moves every claim, the weight block
              // only every `tokens` claims.
              %m = arith.remui %k, %ctok_s : index
              %kn = arith.divui %k, %ctok_s : index
              %kstride = arith.muli %kn, %cmaxdies : index
              %ix = arith.addi %d, %kstride : index
              %has = arith.cmpi ult, %ix, %cheads_s : index
              // A piece whose token is past this step's active count is still
              // claimed and still counted -- the event totals are a property of
              // the task graph, which is static -- it just has nothing to do.
              // Fleet keeps the same static grid and passes num_active_tokens
              // down for the trip counts (gang_linear_mi300.cuh:51).
              %mAct = arith.cmpi ult, %m, %nat : index
              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %pos = arith.addi %wbase, %m : index
                %ropepos = arith.addi %wbase, %m : index
                %hb = arith.muli %ix, %chd_s : index
                scf.execute_region {
                  %hs_q = scf.for %hdi = %c0_s to %chd_s step %c1_s
                      iter_args(%sa_q = %fzero_s) -> (f32) {
                    %hi_q = arith.addi %hb, %hdi : index
                    %hv_q = memref.load %sqkv[%m, %hi_q] : memref<2x256xf32>
                    %hq_q = arith.mulf %hv_q, %hv_q : f32
                    %hn_q = arith.addf %sa_q, %hq_q : f32
                    scf.yield %hn_q : f32
                  }
                  %hm_q = arith.divf %hs_q, %fhd_s : f32
                  %hme_q = arith.addf %hm_q, %eps_s : f32
                  %hr_q = math.sqrt %hme_q : f32
                  scf.for %hdi = %c0_s to %chd_s step %c1_s {
                    %wi_q = arith.addi %hdi, %c0_s : index
                    %hj_q = arith.addi %hb, %hdi : index
                    %hw_q = memref.load %sqkv[%m, %hj_q] : memref<2x256xf32>
                    %nv_q = arith.divf %hw_q, %hr_q : f32
                    %nw_q = memref.load %sqkn[%L0, %wi_q] : memref<2x64xf32>
                    %ov_q = arith.mulf %nv_q, %nw_q : f32
                    memref.store %ov_q, %sqkv[%m, %hj_q] : memref<2x256xf32>
                  }
                  scf.for %hdi = %c0_s to %ch2_s step %c1_s {
                    %i1_q = arith.addi %hb, %hdi : index
                    %dh_q = arith.addi %hdi, %ch2_s : index
                    %i2_q = arith.addi %hb, %dh_q : index
                    %v1_q = memref.load %sqkv[%m, %i1_q] : memref<2x256xf32>
                    %v2_q = memref.load %sqkv[%m, %i2_q] : memref<2x256xf32>
                    %cs_q = memref.load %sro[%ropepos, %hdi] : memref<38x64xf32>
                    %ds_q = arith.addi %hdi, %chd_s : index
                    %sn_q = memref.load %sro[%ropepos, %ds_q] : memref<38x64xf32>
                    %x1_q = arith.mulf %v1_q, %cs_q : f32
                    %y1_q = arith.mulf %v2_q, %sn_q : f32
                    %o1_q = arith.subf %x1_q, %y1_q : f32
                    %x2_q = arith.mulf %v2_q, %cs_q : f32
                    %y2_q = arith.mulf %v1_q, %sn_q : f32
                    %o2_q = arith.addf %x2_q, %y2_q : f32
                    memref.store %o1_q, %sqkv[%m, %i1_q] : memref<2x256xf32>
                    memref.store %o2_q, %sqkv[%m, %i2_q] : memref<2x256xf32>
                  }
                  scf.yield
                }
                %isKv = arith.cmpi ult, %ix, %ckvh_s : index
                scf.if %isKv {
                  %khb = arith.muli %ix, %chd_s : index
                  %kb = arith.addi %ckbase, %khb : index
                  %hs_k = scf.for %hdi = %c0_s to %chd_s step %c1_s
                      iter_args(%sa_k = %fzero_s) -> (f32) {
                    %hi_k = arith.addi %kb, %hdi : index
                    %hv_k = memref.load %sqkv[%m, %hi_k] : memref<2x256xf32>
                    %hq_k = arith.mulf %hv_k, %hv_k : f32
                    %hn_k = arith.addf %sa_k, %hq_k : f32
                    scf.yield %hn_k : f32
                  }
                  %hm_k = arith.divf %hs_k, %fhd_s : f32
                  %hme_k = arith.addf %hm_k, %eps_s : f32
                  %hr_k = math.sqrt %hme_k : f32
                  scf.for %hdi = %c0_s to %chd_s step %c1_s {
                    %wi_k = arith.addi %hdi, %chd_s : index
                    %hj_k = arith.addi %kb, %hdi : index
                    %hw_k = memref.load %sqkv[%m, %hj_k] : memref<2x256xf32>
                    %nv_k = arith.divf %hw_k, %hr_k : f32
                    %nw_k = memref.load %sqkn[%L0, %wi_k] : memref<2x64xf32>
                    %ov_k = arith.mulf %nv_k, %nw_k : f32
                    memref.store %ov_k, %sqkv[%m, %hj_k] : memref<2x256xf32>
                  }
                  scf.for %hdi = %c0_s to %ch2_s step %c1_s {
                    %i1_k = arith.addi %kb, %hdi : index
                    %dh_k = arith.addi %hdi, %ch2_s : index
