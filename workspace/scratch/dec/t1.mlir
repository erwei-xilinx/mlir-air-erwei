                    %mp = arith.mulf %pv, %vv : f32
                    %s2 = arith.addf %sacc, %mp : f32
                    scf.yield %s2 : f32
                  }
                  %oi = arith.addi %hb, %hdi : index
                  memref.store %a, %sav[%m, %oi] : memref<2x128xf32>
