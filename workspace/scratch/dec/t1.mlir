                      iter_args(%s = %fzero_s) -> (f32) {
                    %hi = arith.addi %qhb, %hdi : index
                    %qv = memref.load %sqkv[%m, %hi] : memref<2x256xf32>
                    %kv = memref.load %skc[%L1, %t, %hk, %hdi] {nontemporal = true} : memref<2x38x2x32xf32>
                    %mp = arith.mulf %qv, %kv : f32
                    %s2 = arith.addf %s, %mp : f32
                    scf.yield %s2 : f32
                  }
