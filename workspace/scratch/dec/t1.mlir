          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw1_4 = arith.constant 832 : i64
          %myd1_4 = arith.index_cast %mydie : index to i64
          %myd41_4 = arith.muli %myd1_4, %fourL : i64
          %lb1_4 = arith.addi %lw1_4, %myd41_4 : i64
          %lo1_4 = arith.addi %lb1_4, %steploc : i64
          %locP1_4 = llvm.getelementptr %locp[%lo1_4] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw1_4 = arith.constant 4416 : i64
          %ao1_4 = arith.addi %aw1_4, %lo1_4 : i64
          %arrP1_4 = llvm.getelementptr %locp[%ao1_4] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la1_4 = llvm.atomicrmw add %locP1_4, %t1_4 syncscope("agent") monotonic : !llvm.ptr, i32
