                scf.for %jj = %c0_s to %csliceD step %c1_s {
                  %j = arith.addi %j0, %jj : index
                  %a = scf.for %i = %c0_s to %cqw_s step %c1_s
                      iter_args(%sacc = %fzero_s) -> (f32) {
                    %lv = memref.load %sav[%m, %i] : memref<2x128xf32>
                    %wv = memref.load %swo[%L1, %i, %j] {nontemporal = true} : memref<2x128x128xf32>
                    %mp = arith.mulf %lv, %wv : f32
                    %s2 = arith.addf %sacc, %mp : f32
                    scf.yield %s2 : f32
