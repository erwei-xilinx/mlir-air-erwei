          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw1_2 = arith.constant 704 : i64
          %myd1_2 = arith.index_cast %mydie : index to i64
          %myd41_2 = arith.muli %myd1_2, %fourL : i64
          %lb1_2 = arith.addi %lw1_2, %myd41_2 : i64
          %lo1_2 = arith.addi %lb1_2, %steploc : i64
          %locP1_2 = llvm.getelementptr %locp[%lo1_2] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw1_2 = arith.constant 4416 : i64
          %ao1_2 = arith.addi %aw1_2, %lo1_2 : i64
          %arrP1_2 = llvm.getelementptr %locp[%ao1_2] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la1_2 = llvm.atomicrmw add %locP1_2, %t1_2 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar1_2 = llvm.atomicrmw add %arrP1_2, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last1_2 = arith.subi %mycnt_i, %one_s : i32
          %amLast1_2 = arith.cmpi eq, %ar1_2, %last1_2 : i32
          scf.if %amLast1_2 {
            %tot1_2 = llvm.load %locP1_2 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig1_2 = llvm.atomicrmw add %p1_2, %tot1_2 syncscope("") release : !llvm.ptr, i32
            %cnt1_2 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p1_2 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %nheads_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 3
          %ec1_3 = arith.constant 48 : i64
          %eo1_3 = arith.addi %stepev, %ec1_3 : i64
          %p1_3 = llvm.getelementptr %evptr[%eo1_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hb1_3 = arith.constant 48 : index
          %t1_3 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hb1_3, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L1, %hidx] : (i32, memref<3x2x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
