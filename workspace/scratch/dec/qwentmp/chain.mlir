          // whoever turns out to be last.
          %ar14_2 = llvm.atomicrmw add %arrP14_2, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last14_2 = arith.subi %mycnt_i, %one_s : i32
          %amLast14_2 = arith.cmpi eq, %ar14_2, %last14_2 : i32
          scf.if %amLast14_2 {
            %tot14_2 = llvm.load %locP14_2 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig14_2 = llvm.atomicrmw add %p14_2, %tot14_2 syncscope("") release : !llvm.ptr, i32
            %cnt14_2 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p14_2 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %nheads_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 3
          %ec14_3 = arith.constant 516 : i64
          %eo14_3 = arith.addi %stepev, %ec14_3 : i64
          %p14_3 = llvm.getelementptr %evptr[%eo14_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hb14_3 = arith.constant 48 : index
          %t14_3 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hb14_3, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L14, %hidx] : (i32, memref<2x28x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
