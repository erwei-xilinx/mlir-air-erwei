          // how many times the device-scope one runs.
          %lw14_4 = arith.constant 8320 : i64
          %myd14_4 = arith.index_cast %mydie : index to i64
          %myd414_4 = arith.muli %myd14_4, %fourL : i64
          %lb14_4 = arith.addi %lw14_4, %myd414_4 : i64
