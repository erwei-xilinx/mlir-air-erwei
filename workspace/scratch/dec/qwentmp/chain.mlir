                    %wv = memref.load %swo[%L14, %i, %j] {nontemporal = true} : memref<28x2048x1024xf32>
                    %mp = arith.mulf %lv, %wv : f32
                    %s2 = arith.addf %sacc, %mp : f32
                    scf.yield %s2 : f32
