          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw14_2 = arith.constant 8192 : i64
          %myd14_2 = arith.index_cast %mydie : index to i64
          %myd414_2 = arith.muli %myd14_2, %fourL : i64
          %lb14_2 = arith.addi %lw14_2, %myd414_2 : i64
          %lo14_2 = arith.addi %lb14_2, %steploc : i64
          %locP14_2 = llvm.getelementptr %locp[%lo14_2] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw14_2 = arith.constant 32896 : i64
          %ao14_2 = arith.addi %aw14_2, %lo14_2 : i64
          %arrP14_2 = llvm.getelementptr %locp[%ao14_2] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la14_2 = llvm.atomicrmw add %locP14_2, %t14_2 syncscope("agent") monotonic : !llvm.ptr, i32
