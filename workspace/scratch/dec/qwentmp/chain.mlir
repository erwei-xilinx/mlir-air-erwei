                  %hm_k = arith.divf %hs_k, %fhd_s : f32
                  %hme_k = arith.addf %hm_k, %eps_s : f32
                  %hr_k = math.sqrt %hme_k : f32
                  scf.for %hdi = %c0_s to %chd_s step %c1_s {
                    %wi_k = arith.addi %hdi, %chd_s : index
                    %hj_k = arith.addi %kb, %hdi : index
                    %hw_k = memref.load %sqkv[%m, %hj_k] : memref<5x4096xf32>
                    %nv_k = arith.divf %hw_k, %hr_k : f32
                    %nw_k = memref.load %sqkn[%L14, %wi_k] : memref<28x256xf32>
                    %ov_k = arith.mulf %nv_k, %nw_k : f32
                    memref.store %ov_k, %sqkv[%m, %hj_k] : memref<5x4096xf32>
                  }
                  scf.for %hdi = %c0_s to %ch2_s step %c1_s {
                    %i1_k = arith.addi %kb, %hdi : index
                    %dh_k = arith.addi %hdi, %ch2_s : index
                    %i2_k = arith.addi %kb, %dh_k : index
                    %v1_k = memref.load %sqkv[%m, %i1_k] : memref<5x4096xf32>
                    %v2_k = memref.load %sqkv[%m, %i2_k] : memref<5x4096xf32>
                    %cs_k = memref.load %sro[%ropepos, %hdi] : memref<10x256xf32>
                    %ds_k = arith.addi %hdi, %chd_s : index
                    %sn_k = memref.load %sro[%ropepos, %ds_k] : memref<10x256xf32>
                    %x1_k = arith.mulf %v1_k, %cs_k : f32
                    %y1_k = arith.mulf %v2_k, %sn_k : f32
                    %o1_k = arith.subf %x1_k, %y1_k : f32
                    %x2_k = arith.mulf %v2_k, %cs_k : f32
                    %y2_k = arith.mulf %v1_k, %sn_k : f32
                    %o2_k = arith.addf %x2_k, %y2_k : f32
                    memref.store %o1_k, %sqkv[%m, %i1_k] : memref<5x4096xf32>
                    memref.store %o2_k, %sqkv[%m, %i2_k] : memref<5x4096xf32>
                  }
                  %vb = arith.addi %cvbase, %khb : index
                  scf.for %hdi = %c0_s to %chd_s step %c1_s {
                    %ki = arith.addi %kb, %hdi : index
                    %kv = memref.load %sqkv[%m, %ki] : memref<5x4096xf32>
                    memref.store %kv, %skc[%L14, %pos, %ix, %hdi] : memref<28x10x8x128xf32>
                    %vi = arith.addi %vb, %hdi : index
                    %vv = memref.load %sqkv[%m, %vi] : memref<5x4096xf32>
                    memref.store %vv, %svc[%L14, %pos, %ix, %hdi] : memref<28x10x8x128xf32>
