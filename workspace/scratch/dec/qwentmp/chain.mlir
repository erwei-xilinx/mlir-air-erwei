              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %j0 = arith.muli %ix, %csliceD : index
                scf.for %jj = %c0_s to %csliceD step %c1_s {
                  %j = arith.addi %j0, %jj : index
                  %a = scf.for %i = %c0_s to %cinter_s step %c1_s
                      iter_args(%sacc = %fzero_s) -> (f32) {
                    %lv = memref.load %sact[%m, %i] : memref<5x3072xf32>
                    %wv = memref.load %swd[%L27, %i, %j] {nontemporal = true} : memref<28x3072x1024xf32>
                    %mp = arith.mulf %lv, %wv : f32
                    %s2 = arith.addf %sacc, %mp : f32
                    scf.yield %s2 : f32
                  }
                  %rv = memref.load %sxa[%m, %j] : memref<5x1024xf32>
                  %a2 = arith.addf %rv, %a : f32
                  memref.store %a2, %sx[%m, %j] : memref<5x1024xf32>
                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw27_8 = arith.constant 16064 : i64
          %myd27_8 = arith.index_cast %mydie : index to i64
          %myd427_8 = arith.muli %myd27_8, %fourL : i64
          %lb27_8 = arith.addi %lw27_8, %myd427_8 : i64
          %lo27_8 = arith.addi %lb27_8, %steploc : i64
          %locP27_8 = llvm.getelementptr %locp[%lo27_8] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw27_8 = arith.constant 32896 : i64
          %ao27_8 = arith.addi %aw27_8, %lo27_8 : i64
          %arrP27_8 = llvm.getelementptr %locp[%ao27_8] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la27_8 = llvm.atomicrmw add %locP27_8, %t27_8 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar27_8 = llvm.atomicrmw add %arrP27_8, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last27_8 = arith.subi %mycnt_i, %one_s : i32
          %amLast27_8 = arith.cmpi eq, %ar27_8, %last27_8 : i32
          scf.if %amLast27_8 {
            %tot27_8 = llvm.load %locP27_8 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig27_8 = llvm.atomicrmw add %p27_8, %tot27_8 syncscope("") release : !llvm.ptr, i32
            %cnt27_8 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p27_8 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %ntasks_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 10 -- one task: a reduction over the whole row, so it
          // cannot be split by output slice the way the matmuls can.
          %hsingle10_x = arith.constant 160 : index
          %ecx_10 = arith.constant 1012 : i64
          %eox_10 = arith.addi %stepev, %ecx_10 : i64
          %px_10 = llvm.getelementptr %evptr[%eox_10] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %clx_10 = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hsingle10_x] : (i32, memref<2x28x224xi32>) -> i32
          %minex_10 = arith.cmpi eq, %clx_10, %zero_s : i32
          scf.if %minex_10 {
            scf.for %m = %c0_s to %nat step %c1_s {
              %fs = scf.for %i = %c0_s to %cdim_s step %c1_s
                  iter_args(%a = %fzero_s) -> (f32) {
                %v = memref.load %sx[%m, %i] : memref<5x1024xf32>
                %fq = arith.mulf %v, %v : f32
                %a2 = arith.addf %a, %fq : f32
                scf.yield %a2 : f32
              }
              %fm = arith.divf %fs, %fdim_s : f32
              %fme = arith.addf %fm, %eps_s : f32
              %fr = math.sqrt %fme : f32
              scf.for %i = %c0_s to %cdim_s step %c1_s {
                %v = memref.load %sx[%m, %i] : memref<5x1024xf32>
                %nv = arith.divf %v, %fr : f32
                %nw = memref.load %snf[%i] : memref<1024xf32>
                %o = arith.mulf %nv, %nw : f32
                memref.store %o, %sr[%m, %i] : memref<5x1024xf32>
              }
            }
            %sigx_10 = llvm.atomicrmw add %px_10, %n1_s syncscope("") release : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %px_10 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %n1_s : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 11
          %ecx_11 = arith.constant 1016 : i64
          %eox_11 = arith.addi %stepev, %ecx_11 : i64
          %px_11 = llvm.getelementptr %evptr[%eox_11] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hbx_11 = arith.constant 176 : index
          %tx_11 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hbx_11, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hidx] : (i32, memref<2x28x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
              // M fast, N slow: the token moves every claim, the weight block
              // only every `tokens` claims.
              %m = arith.remui %k, %ctok_s : index
              %kn = arith.divui %k, %ctok_s : index
              %kstride = arith.muli %kn, %cmaxdies : index
              %ix = arith.addi %d, %kstride : index
              %has = arith.cmpi ult, %ix, %ctasks : index
              // A piece whose token is past this step's active count is still
              // claimed and still counted -- the event totals are a property of
              // the task graph, which is static -- it just has nothing to do.
              // Fleet keeps the same static grid and passes num_active_tokens
              // down for the trip counts (gang_linear_mi300.cuh:51).
              %mAct = arith.cmpi ult, %m, %nat : index
              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %v0 = arith.muli %ix, %csliceV : index
                scf.for %jj = %c0_s to %csliceV step %c1_s {
                  %v = arith.addi %v0, %jj : index
                  %a = scf.for %i = %c0_s to %cdim_s step %c1_s
                      iter_args(%sacc = %fzero_s) -> (f32) {
                    %xv = memref.load %sr[%m, %i] : memref<5x1024xf32>
                    %wv = memref.load %swlm[%i, %v] {nontemporal = true} : memref<1024x151936xf32>
                    %mp = arith.mulf %xv, %wv : f32
                    %s2 = arith.addf %sacc, %mp : f32
                    scf.yield %s2 : f32
                  }
                  memref.store %a, %slg[%m, %v] : memref<5x151936xf32>
                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lwx_11 = arith.constant 16256 : i64
          %mydx_11 = arith.index_cast %mydie : index to i64
          %myd4x_11 = arith.muli %mydx_11, %fourL : i64
          %lbx_11 = arith.addi %lwx_11, %myd4x_11 : i64
          %lox_11 = arith.addi %lbx_11, %steploc : i64
          %locPx_11 = llvm.getelementptr %locp[%lox_11] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %awx_11 = arith.constant 32896 : i64
          %aox_11 = arith.addi %awx_11, %lox_11 : i64
          %arrPx_11 = llvm.getelementptr %locp[%aox_11] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %lax_11 = llvm.atomicrmw add %locPx_11, %tx_11 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %arx_11 = llvm.atomicrmw add %arrPx_11, %one_s syncscope("agent") release : !llvm.ptr, i32
          %lastx_11 = arith.subi %mycnt_i, %one_s : i32
          %amLastx_11 = arith.cmpi eq, %arx_11, %lastx_11 : i32
          scf.if %amLastx_11 {
            %totx_11 = llvm.load %locPx_11 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sigx_11 = llvm.atomicrmw add %px_11, %totx_11 syncscope("") release : !llvm.ptr, i32
            %cntx_11 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %px_11 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %ntasks_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 12
          %ecx_12 = arith.constant 1020 : i64
          %eox_12 = arith.addi %stepev, %ecx_12 : i64
          %px_12 = llvm.getelementptr %evptr[%eox_12] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hbx_12 = arith.constant 192 : index
          %tx_12 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hbx_12, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hidx] : (i32, memref<2x28x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
              // M fast, N slow: the token moves every claim, the weight block
              // only every `tokens` claims.
              %m = arith.remui %k, %ctok_s : index
              %kn = arith.divui %k, %ctok_s : index
              %kstride = arith.muli %kn, %cmaxdies : index
              %ix = arith.addi %d, %kstride : index
              %has = arith.cmpi ult, %ix, %ctasks : index
              // A piece whose token is past this step's active count is still
              // claimed and still counted -- the event totals are a property of
              // the task graph, which is static -- it just has nothing to do.
              // Fleet keeps the same static grid and passes num_active_tokens
              // down for the trip counts (gang_linear_mi300.cuh:51).
              %mAct = arith.cmpi ult, %m, %nat : index
              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %v0 = arith.muli %ix, %csliceV : index
                %bi:2 = scf.for %jj = %c0_s to %csliceV step %c1_s
                    iter_args(%bv = %negbig_s, %bidx = %zero_s) -> (f32, i32) {
                  %v = arith.addi %v0, %jj : index
                  %lv = memref.load %slg[%m, %v] : memref<5x151936xf32>
                  %gt = arith.cmpf ogt, %lv, %bv : f32
                  %nv2 = arith.select %gt, %lv, %bv : f32
                  %vi = arith.index_cast %v : index to i32
                  %nx = arith.select %gt, %vi, %bidx : i32
                  scf.yield %nv2, %nx : f32, i32
                }
                memref.store %bi#0, %spv[%m, %ix] : memref<5x32xf32>
                memref.store %bi#1, %spi[%m, %ix] : memref<5x32xi32>
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lwx_12 = arith.constant 16320 : i64
          %mydx_12 = arith.index_cast %mydie : index to i64
          %myd4x_12 = arith.muli %mydx_12, %fourL : i64
          %lbx_12 = arith.addi %lwx_12, %myd4x_12 : i64
          %lox_12 = arith.addi %lbx_12, %steploc : i64
          %locPx_12 = llvm.getelementptr %locp[%lox_12] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %awx_12 = arith.constant 32896 : i64
          %aox_12 = arith.addi %awx_12, %lox_12 : i64
          %arrPx_12 = llvm.getelementptr %locp[%aox_12] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %lax_12 = llvm.atomicrmw add %locPx_12, %tx_12 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %arx_12 = llvm.atomicrmw add %arrPx_12, %one_s syncscope("agent") release : !llvm.ptr, i32
          %lastx_12 = arith.subi %mycnt_i, %one_s : i32
          %amLastx_12 = arith.cmpi eq, %arx_12, %lastx_12 : i32
          scf.if %amLastx_12 {
            %totx_12 = llvm.load %locPx_12 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sigx_12 = llvm.atomicrmw add %px_12, %totx_12 syncscope("") release : !llvm.ptr, i32
            %cntx_12 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %px_12 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %ntasks_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 13 -- one task: a reduction over the whole row, so it
          // cannot be split by output slice the way the matmuls can.
          %hsingle13_x = arith.constant 208 : index
          %ecx_13 = arith.constant 1024 : i64
          %eox_13 = arith.addi %stepev, %ecx_13 : i64
          %px_13 = llvm.getelementptr %evptr[%eox_13] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %clx_13 = memref.atomic_rmw addi %one_s, %sq[%step, %L0, %hsingle13_x] : (i32, memref<2x28x224xi32>) -> i32
          %minex_13 = arith.cmpi eq, %clx_13, %zero_s : i32
          scf.if %minex_13 {
            scf.for %m = %c0_s to %nat step %c1_s {
              %rd:2 = scf.for %k = %c0_s to %ctasks step %c1_s
                  iter_args(%bv = %negbig_s, %bidx = %zero_s) -> (f32, i32) {
                %apv = memref.load %spv[%m, %k] : memref<5x32xf32>
                %api = memref.load %spi[%m, %k] : memref<5x32xi32>
                %gt = arith.cmpf ogt, %apv, %bv : f32
                %nv2 = arith.select %gt, %apv, %bv : f32
                %nx = arith.select %gt, %api, %bidx : i32
                scf.yield %nv2, %nx : f32, i32
              }
              // One next token per sequence: the argmax of the last active
              // position, and only once that slot is past the prompt. Fleet
              // guards the same write (persistent_kernel.cuh:396).
              %lastm = arith.subi %nat, %c1_s : index
              %isLastRow = arith.cmpi eq, %m, %lastm : index
              scf.if %isLastRow {
                %nxt = arith.addi %seq, %nat : index
                %past = arith.cmpi sge, %nxt, %plen_s : index
                scf.if %past {
                  memref.store %rd#1, %stok[%nxt] : memref<11xi32>
                }
              }
            }
            %sigx_13 = llvm.atomicrmw add %px_13, %n1_s syncscope("") release : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %px_13 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %n1_s : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
            %seqn = arith.addi %seq, %nat : index
            scf.yield %seqn : index
          }
        }

        air.herd @herd tile (%htx, %hty) in (%ntx=%c1_s, %nty=%c1_s) {
        }
      }
    }
    return
  }
}
