                    %dh_q = arith.addi %hdi, %ch2_s : index
                    %i2_q = arith.addi %hb, %dh_q : index
                    %v1_q = memref.load %sqkv[%m, %i1_q] : memref<5x4096xf32>
                    %v2_q = memref.load %sqkv[%m, %i2_q] : memref<5x4096xf32>
                    %cs_q = memref.load %sro[%ropepos, %hdi] : memref<10x256xf32>
                    %ds_q = arith.addi %hdi, %chd_s : index
                    %sn_q = memref.load %sro[%ropepos, %ds_q] : memref<10x256xf32>
