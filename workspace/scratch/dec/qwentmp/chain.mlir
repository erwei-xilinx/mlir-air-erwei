          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw14_3 = arith.constant 8256 : i64
          %myd14_3 = arith.index_cast %mydie : index to i64
          %myd414_3 = arith.muli %myd14_3, %fourL : i64
          %lb14_3 = arith.addi %lw14_3, %myd414_3 : i64
          %lo14_3 = arith.addi %lb14_3, %steploc : i64
          %locP14_3 = llvm.getelementptr %locp[%lo14_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw14_3 = arith.constant 32896 : i64
          %ao14_3 = arith.addi %aw14_3, %lo14_3 : i64
          %arrP14_3 = llvm.getelementptr %locp[%ao14_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la14_3 = llvm.atomicrmw add %locP14_3, %t14_3 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar14_3 = llvm.atomicrmw add %arrP14_3, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last14_3 = arith.subi %mycnt_i, %one_s : i32
          %amLast14_3 = arith.cmpi eq, %ar14_3, %last14_3 : i32
          scf.if %amLast14_3 {
