          %p4_3 = llvm.getelementptr %evptr[%eo4_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hb4_3 = arith.constant 48 : index
          %t4_3 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
