          %eo14_5 = arith.addi %stepev, %ec14_5 : i64
          %p14_5 = llvm.getelementptr %evptr[%eo14_5] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %cl14_5 = memref.atomic_rmw addi %one_s, %sq[%step, %L14, %hsingle5_14] : (i32, memref<2x28x224xi32>) -> i32
          %mine14_5 = arith.cmpi eq, %cl14_5, %zero_s : i32
          scf.if %mine14_5 {
