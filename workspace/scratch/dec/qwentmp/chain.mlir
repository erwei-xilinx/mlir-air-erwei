          %last14_4 = arith.subi %mycnt_i, %one_s : i32
          %amLast14_4 = arith.cmpi eq, %ar14_4, %last14_4 : i32
          scf.if %amLast14_4 {
            %tot14_4 = llvm.load %locP14_4 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig14_4 = llvm.atomicrmw add %p14_4, %tot14_4 syncscope("") release : !llvm.ptr, i32
            %cnt14_4 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
