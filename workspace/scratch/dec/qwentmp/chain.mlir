          %eo14_4 = arith.addi %stepev, %ec14_4 : i64
          %p14_4 = llvm.getelementptr %evptr[%eo14_4] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hb14_4 = arith.constant 64 : index
          %t14_4 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
