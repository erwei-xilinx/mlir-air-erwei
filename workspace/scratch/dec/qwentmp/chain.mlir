          %cl10_0 = memref.atomic_rmw addi %one_s, %sq[%step, %L10, %hsingle0_10] : (i32, memref<2x28x224xi32>) -> i32
          %mine10_0 = arith.cmpi eq, %cl10_0, %zero_s : i32
