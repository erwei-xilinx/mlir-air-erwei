                    %hv_q = memref.load %sqkv[%m, %hi_q] : memref<5x4096xf32>
                    %hq_q = arith.mulf %hv_q, %hv_q : f32
                    %hn_q = arith.addf %sa_q, %hq_q : f32
                    scf.yield %hn_q : f32
                  }
                  %hm_q = arith.divf %hs_q, %fhd_s : f32
                  %hme_q = arith.addf %hm_q, %eps_s : f32
                  %hr_q = math.sqrt %hme_q : f32
                  scf.for %hdi = %c0_s to %chd_s step %c1_s {
                    %wi_q = arith.addi %hdi, %c0_s : index
                    %hj_q = arith.addi %hb, %hdi : index
                    %hw_q = memref.load %sqkv[%m, %hj_q] : memref<5x4096xf32>
                    %nv_q = arith.divf %hw_q, %hr_q : f32
                    %nw_q = memref.load %sqkn[%L5, %wi_q] : memref<28x256xf32>
                    %ov_q = arith.mulf %nv_q, %nw_q : f32
                    memref.store %ov_q, %sqkv[%m, %hj_q] : memref<5x4096xf32>
                  }
                  scf.for %hdi = %c0_s to %ch2_s step %c1_s {
                    %i1_q = arith.addi %hb, %hdi : index
                    %dh_q = arith.addi %hdi, %ch2_s : index
                    %i2_q = arith.addi %hb, %dh_q : index
                    %v1_q = memref.load %sqkv[%m, %i1_q] : memref<5x4096xf32>
                    %v2_q = memref.load %sqkv[%m, %i2_q] : memref<5x4096xf32>
                    %cs_q = memref.load %sro[%ropepos, %hdi] : memref<10x256xf32>
                    %ds_q = arith.addi %hdi, %chd_s : index
                    %sn_q = memref.load %sro[%ropepos, %ds_q] : memref<10x256xf32>
                    %x1_q = arith.mulf %v1_q, %cs_q : f32
                    %y1_q = arith.mulf %v2_q, %sn_q : f32
                    %o1_q = arith.subf %x1_q, %y1_q : f32
                    %x2_q = arith.mulf %v2_q, %cs_q : f32
                    %y2_q = arith.mulf %v1_q, %sn_q : f32
                    %o2_q = arith.addf %x2_q, %y2_q : f32
                    memref.store %o1_q, %sqkv[%m, %i1_q] : memref<5x4096xf32>
                    memref.store %o2_q, %sqkv[%m, %i2_q] : memref<5x4096xf32>
                  }
                  scf.yield
                }
                %isKv = arith.cmpi ult, %ix, %ckvh_s : index
                scf.if %isKv {
                  %khb = arith.muli %ix, %chd_s : index
                  %kb = arith.addi %ckbase, %khb : index
                  %hs_k = scf.for %hdi = %c0_s to %chd_s step %c1_s
                      iter_args(%sa_k = %fzero_s) -> (f32) {
                    %hi_k = arith.addi %kb, %hdi : index
                    %hv_k = memref.load %sqkv[%m, %hi_k] : memref<5x4096xf32>
                    %hq_k = arith.mulf %hv_k, %hv_k : f32
                    %hn_k = arith.addf %sa_k, %hq_k : f32
                    scf.yield %hn_k : f32
                  }
                  %hm_k = arith.divf %hs_k, %fhd_s : f32
                  %hme_k = arith.addf %hm_k, %eps_s : f32
                  %hr_k = math.sqrt %hme_k : f32
                  scf.for %hdi = %c0_s to %chd_s step %c1_s {
                    %wi_k = arith.addi %hdi, %chd_s : index
                    %hj_k = arith.addi %kb, %hdi : index
                    %hw_k = memref.load %sqkv[%m, %hj_k] : memref<5x4096xf32>
                    %nv_k = arith.divf %hw_k, %hr_k : f32
                    %nw_k = memref.load %sqkn[%L5, %wi_k] : memref<28x256xf32>
                    %ov_k = arith.mulf %nv_k, %nw_k : f32
                    memref.store %ov_k, %sqkv[%m, %hj_k] : memref<5x4096xf32>
                  }
                  scf.for %hdi = %c0_s to %ch2_s step %c1_s {
                    %i1_k = arith.addi %kb, %hdi : index
                    %dh_k = arith.addi %hdi, %ch2_s : index
                    %i2_k = arith.addi %kb, %dh_k : index
                    %v1_k = memref.load %sqkv[%m, %i1_k] : memref<5x4096xf32>
                    %v2_k = memref.load %sqkv[%m, %i2_k] : memref<5x4096xf32>
                    %cs_k = memref.load %sro[%ropepos, %hdi] : memref<10x256xf32>
                    %ds_k = arith.addi %hdi, %chd_s : index
                    %sn_k = memref.load %sro[%ropepos, %ds_k] : memref<10x256xf32>
                    %x1_k = arith.mulf %v1_k, %cs_k : f32
                    %y1_k = arith.mulf %v2_k, %sn_k : f32
                    %o1_k = arith.subf %x1_k, %y1_k : f32
                    %x2_k = arith.mulf %v2_k, %cs_k : f32
                    %y2_k = arith.mulf %v1_k, %sn_k : f32
                    %o2_k = arith.addf %x2_k, %y2_k : f32
                    memref.store %o1_k, %sqkv[%m, %i1_k] : memref<5x4096xf32>
                    memref.store %o2_k, %sqkv[%m, %i2_k] : memref<5x4096xf32>
                  }
                  %vb = arith.addi %cvbase, %khb : index
                  scf.for %hdi = %c0_s to %chd_s step %c1_s {
                    %ki = arith.addi %kb, %hdi : index
                    %kv = memref.load %sqkv[%m, %ki] : memref<5x4096xf32>
                    memref.store %kv, %skc[%L5, %pos, %ix, %hdi] : memref<28x10x8x128xf32>
                    %vi = arith.addi %vb, %hdi : index
                    %vv = memref.load %sqkv[%m, %vi] : memref<5x4096xf32>
                    memref.store %vv, %svc[%L5, %pos, %ix, %hdi] : memref<28x10x8x128xf32>
                  }
                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw5_2 = arith.constant 3008 : i64
          %myd5_2 = arith.index_cast %mydie : index to i64
          %myd45_2 = arith.muli %myd5_2, %fourL : i64
          %lb5_2 = arith.addi %lw5_2, %myd45_2 : i64
          %lo5_2 = arith.addi %lb5_2, %steploc : i64
          %locP5_2 = llvm.getelementptr %locp[%lo5_2] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw5_2 = arith.constant 32896 : i64
          %ao5_2 = arith.addi %aw5_2, %lo5_2 : i64
          %arrP5_2 = llvm.getelementptr %locp[%ao5_2] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la5_2 = llvm.atomicrmw add %locP5_2, %t5_2 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar5_2 = llvm.atomicrmw add %arrP5_2, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last5_2 = arith.subi %mycnt_i, %one_s : i32
          %amLast5_2 = arith.cmpi eq, %ar5_2, %last5_2 : i32
          scf.if %amLast5_2 {
            %tot5_2 = llvm.load %locP5_2 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig5_2 = llvm.atomicrmw add %p5_2, %tot5_2 syncscope("") release : !llvm.ptr, i32
            %cnt5_2 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p5_2 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %nheads_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 3
          %ec5_3 = arith.constant 192 : i64
          %eo5_3 = arith.addi %stepev, %ec5_3 : i64
          %p5_3 = llvm.getelementptr %evptr[%eo5_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hb5_3 = arith.constant 48 : index
          %t5_3 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hb5_3, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L5, %hidx] : (i32, memref<2x28x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
              // M fast, N slow: the token moves every claim, the weight block
              // only every `tokens` claims.
              %m = arith.remui %k, %ctok_s : index
              %kn = arith.divui %k, %ctok_s : index
              %kstride = arith.muli %kn, %cmaxdies : index
              %ix = arith.addi %d, %kstride : index
              %has = arith.cmpi ult, %ix, %cheads_s : index
              // A piece whose token is past this step's active count is still
              // claimed and still counted -- the event totals are a property of
              // the task graph, which is static -- it just has nothing to do.
              // Fleet keeps the same static grid and passes num_active_tokens
              // down for the trip counts (gang_linear_mi300.cuh:51).
              %mAct = arith.cmpi ult, %m, %nat : index
              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %pos = arith.addi %wbase, %m : index
                %qhb = arith.muli %ix, %chd_s : index
                %hb = arith.muli %ix, %chd_s : index
                %hk = arith.divui %ix, %cgroup_s : index
                %mxs = scf.for %t = %c0_s to %curlen step %c1_s
                    iter_args(%mv = %negbig_s) -> (f32) {
                  %dot = scf.for %hdi = %c0_s to %chd_s step %c1_s
                      iter_args(%s = %fzero_s) -> (f32) {
                    %hi = arith.addi %qhb, %hdi : index
                    %qv = memref.load %sqkv[%m, %hi] : memref<5x4096xf32>
                    %kv = memref.load %skc[%L5, %t, %hk, %hdi] {nontemporal = true} : memref<28x10x8x128xf32>
                    %mp = arith.mulf %qv, %kv : f32
                    %s2 = arith.addf %s, %mp : f32
                    scf.yield %s2 : f32
                  }
                  %scv = arith.mulf %dot, %invsqrthd_s : f32
                  // causal over the window: token m sees the prefix and the
                  // window entries up to and including its own
                  %okm = arith.cmpi ule, %t, %pos : index
                  %scm = arith.select %okm, %scv, %negbig_s : f32
                  memref.store %scm, %ssc[%m, %ix, %t] : memref<5x16x10xf32>
                  %m2 = arith.maxnumf %mv, %scm : f32
                  scf.yield %m2 : f32
                }
                %sum = scf.for %t = %c0_s to %curlen step %c1_s
                    iter_args(%sm = %fzero_s) -> (f32) {
                  %v = memref.load %ssc[%m, %ix, %t] : memref<5x16x10xf32>
                  %dd = arith.subf %v, %mxs : f32
                  %e = math.exp %dd : f32
                  memref.store %e, %ssc[%m, %ix, %t] : memref<5x16x10xf32>
                  %s2 = arith.addf %sm, %e : f32
                  scf.yield %s2 : f32
                }
                scf.for %hdi = %c0_s to %chd_s step %c1_s {
                  %a = scf.for %t = %c0_s to %curlen step %c1_s
                      iter_args(%sacc = %fzero_s) -> (f32) {
                    %e = memref.load %ssc[%m, %ix, %t] : memref<5x16x10xf32>
                    %pv = arith.divf %e, %sum : f32
                    %vv = memref.load %svc[%L5, %t, %hk, %hdi] {nontemporal = true} : memref<28x10x8x128xf32>
                    %mp = arith.mulf %pv, %vv : f32
                    %s2 = arith.addf %sacc, %mp : f32
                    scf.yield %s2 : f32
                  }
                  %oi = arith.addi %hb, %hdi : index
                  memref.store %a, %sav[%m, %oi] : memref<5x2048xf32>
                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw5_3 = arith.constant 3072 : i64
          %myd5_3 = arith.index_cast %mydie : index to i64
          %myd45_3 = arith.muli %myd5_3, %fourL : i64
          %lb5_3 = arith.addi %lw5_3, %myd45_3 : i64
          %lo5_3 = arith.addi %lb5_3, %steploc : i64
          %locP5_3 = llvm.getelementptr %locp[%lo5_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw5_3 = arith.constant 32896 : i64
          %ao5_3 = arith.addi %aw5_3, %lo5_3 : i64
          %arrP5_3 = llvm.getelementptr %locp[%ao5_3] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la5_3 = llvm.atomicrmw add %locP5_3, %t5_3 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar5_3 = llvm.atomicrmw add %arrP5_3, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last5_3 = arith.subi %mycnt_i, %one_s : i32
          %amLast5_3 = arith.cmpi eq, %ar5_3, %last5_3 : i32
          scf.if %amLast5_3 {
            %tot5_3 = llvm.load %locP5_3 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig5_3 = llvm.atomicrmw add %p5_3, %tot5_3 syncscope("") release : !llvm.ptr, i32
            %cnt5_3 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p5_3 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %nheads_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 4
          %ec5_4 = arith.constant 196 : i64
          %eo5_4 = arith.addi %stepev, %ec5_4 : i64
          %p5_4 = llvm.getelementptr %evptr[%eo5_4] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %hb5_4 = arith.constant 64 : index
          %t5_4 = scf.for %pp = %c0_s to %cmaxdies step %c1_s
              iter_args(%outer = %zero_s) -> (i32) {
            // Own die first, then the others in order.
            %draw = arith.addi %mydie, %pp : index
            %d = arith.remui %draw, %cmaxdies : index
            %hidx = arith.addi %hb5_4, %d : index
            %inner:2 = scf.while (%go = %true, %acc = %outer) : (i1, i32) -> (i1, i32) {
              scf.condition(%go) %go, %acc : i1, i32
            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L5, %hidx] : (i32, memref<2x28x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
              // M fast, N slow: the token moves every claim, the weight block
              // only every `tokens` claims.
              %m = arith.remui %k, %ctok_s : index
              %kn = arith.divui %k, %ctok_s : index
              %kstride = arith.muli %kn, %cmaxdies : index
              %ix = arith.addi %d, %kstride : index
              %has = arith.cmpi ult, %ix, %ctasks : index
              // A piece whose token is past this step's active count is still
              // claimed and still counted -- the event totals are a property of
              // the task graph, which is static -- it just has nothing to do.
              // Fleet keeps the same static grid and passes num_active_tokens
              // down for the trip counts (gang_linear_mi300.cuh:51).
              %mAct = arith.cmpi ult, %m, %nat : index
              %acc2 = scf.if %has -> i32 {
                scf.if %mAct {
                %j0 = arith.muli %ix, %csliceD : index
                scf.for %jj = %c0_s to %csliceD step %c1_s {
                  %j = arith.addi %j0, %jj : index
                  %a = scf.for %i = %c0_s to %cqw_s step %c1_s
                      iter_args(%sacc = %fzero_s) -> (f32) {
                    %lv = memref.load %sav[%m, %i] : memref<5x2048xf32>
                    %wv = memref.load %swo[%L5, %i, %j] {nontemporal = true} : memref<28x2048x1024xf32>
                    %mp = arith.mulf %lv, %wv : f32
                    %s2 = arith.addf %sacc, %mp : f32
                    scf.yield %s2 : f32
                  }
                  memref.store %a, %saov[%m, %j] : memref<5x1024xf32>
                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw5_4 = arith.constant 3136 : i64
          %myd5_4 = arith.index_cast %mydie : index to i64
          %myd45_4 = arith.muli %myd5_4, %fourL : i64
          %lb5_4 = arith.addi %lw5_4, %myd45_4 : i64
          %lo5_4 = arith.addi %lb5_4, %steploc : i64
          %locP5_4 = llvm.getelementptr %locp[%lo5_4] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw5_4 = arith.constant 32896 : i64
          %ao5_4 = arith.addi %aw5_4, %lo5_4 : i64
          %arrP5_4 = llvm.getelementptr %locp[%ao5_4] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la5_4 = llvm.atomicrmw add %locP5_4, %t5_4 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar5_4 = llvm.atomicrmw add %arrP5_4, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last5_4 = arith.subi %mycnt_i, %one_s : i32
          %amLast5_4 = arith.cmpi eq, %ar5_4, %last5_4 : i32
          scf.if %amLast5_4 {
            %tot5_4 = llvm.load %locP5_4 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig5_4 = llvm.atomicrmw add %p5_4, %tot5_4 syncscope("") release : !llvm.ptr, i32
            %cnt5_4 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p5_4 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %ntasks_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // stage 5 -- one task: a reduction over the whole row, so it
          // cannot be split by output slice the way the matmuls can.
          %hsingle5_5 = arith.constant 80 : index
          %ec5_5 = arith.constant 200 : i64
          %eo5_5 = arith.addi %stepev, %ec5_5 : i64
          %p5_5 = llvm.getelementptr %evptr[%eo5_5] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %cl5_5 = memref.atomic_rmw addi %one_s, %sq[%step, %L5, %hsingle5_5] : (i32, memref<2x28x224xi32>) -> i32
          %mine5_5 = arith.cmpi eq, %cl5_5, %zero_s : i32
          scf.if %mine5_5 {
            scf.for %m = %c0_s to %nat step %c1_s {
              %ssa5 = scf.for %i = %c0_s to %cdim_s step %c1_s
                  iter_args(%s = %fzero_s) -> (f32) {
                %xv = memref.load %sx[%m, %i] : memref<5x1024xf32>
                %avv = memref.load %saov[%m, %i] : memref<5x1024xf32>
                %xa = arith.addf %xv, %avv : f32
                memref.store %xa, %sxa[%m, %i] : memref<5x1024xf32>
                %sqa = arith.mulf %xa, %xa : f32
                %s2 = arith.addf %s, %sqa : f32
                scf.yield %s2 : f32
              }
              %meana5 = arith.divf %ssa5, %fdim_s : f32
              %mea5 = arith.addf %meana5, %eps_s : f32
              %rmsa5 = math.sqrt %mea5 : f32
              // The normed copy goes somewhere else: stage 8 closes the
              // residual onto the unnormalised one, which is what a decoder
              // layer does. %sr is free here -- stage 1 was the last reader.
              scf.for %i = %c0_s to %cdim_s step %c1_s {
                %xv3 = memref.load %sxa[%m, %i] : memref<5x1024xf32>
                %nv = arith.divf %xv3, %rmsa5 : f32
