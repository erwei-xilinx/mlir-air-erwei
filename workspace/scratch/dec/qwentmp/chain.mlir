          %aw14_4 = arith.constant 32896 : i64
          %ao14_4 = arith.addi %aw14_4, %lo14_4 : i64
          %arrP14_4 = llvm.getelementptr %locp[%ao14_4] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la14_4 = llvm.atomicrmw add %locP14_4, %t14_4 syncscope("agent") monotonic : !llvm.ptr, i32
