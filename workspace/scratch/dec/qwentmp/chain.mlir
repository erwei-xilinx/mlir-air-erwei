            } do {
            ^bb0(%g: i1, %acc: i32):
              %cl = memref.atomic_rmw addi %one_s, %sq[%step, %L1, %hidx] : (i32, memref<2x28x224xi32>) -> i32
              %k = arith.index_cast %cl : i32 to index
