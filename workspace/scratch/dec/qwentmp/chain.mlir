                  %a2 = arith.addf %rv, %a : f32
                  memref.store %a2, %sx[%m, %j] : memref<5x1024xf32>
                }
                }
                %n = arith.addi %acc, %one_s : i32
                scf.yield %n : i32
              } else {
                scf.yield %acc : i32
              }
              scf.yield %has, %acc2 : i1, i32
            }
            scf.yield %inner#1 : i32
          }
          // Two-level: add into a counter only this die touches, then let the
          // last worker on the die flush the die's whole share once. The
          // instructions are the same as signalling per worker; what changes is
          // how many times the device-scope one runs.
          %lw0_8 = arith.constant 512 : i64
          %myd0_8 = arith.index_cast %mydie : index to i64
          %myd40_8 = arith.muli %myd0_8, %fourL : i64
          %lb0_8 = arith.addi %lw0_8, %myd40_8 : i64
          %lo0_8 = arith.addi %lb0_8, %steploc : i64
          %locP0_8 = llvm.getelementptr %locp[%lo0_8] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %aw0_8 = arith.constant 32896 : i64
          %ao0_8 = arith.addi %aw0_8, %lo0_8 : i64
          %arrP0_8 = llvm.getelementptr %locp[%ao0_8] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %la0_8 = llvm.atomicrmw add %locP0_8, %t0_8 syncscope("agent") monotonic : !llvm.ptr, i32
          // Release on the arrival so the accumulate above is visible to
          // whoever turns out to be last.
          %ar0_8 = llvm.atomicrmw add %arrP0_8, %one_s syncscope("agent") release : !llvm.ptr, i32
          %last0_8 = arith.subi %mycnt_i, %one_s : i32
          %amLast0_8 = arith.cmpi eq, %ar0_8, %last0_8 : i32
          scf.if %amLast0_8 {
            %tot0_8 = llvm.load %locP0_8 atomic syncscope("agent") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %sig0_8 = llvm.atomicrmw add %p0_8, %tot0_8 syncscope("") release : !llvm.ptr, i32
            %cnt0_8 = llvm.atomicrmw add %flushP, %one_s syncscope("") monotonic : !llvm.ptr, i32
          }
          scf.while : () -> () {
            %seen = llvm.load %p0_8 atomic syncscope("") acquire {alignment = 4 : i64} : !llvm.ptr -> i32
            %notYet = arith.cmpi ult, %seen, %ntasks_t : i32
            scf.condition(%notYet)
          } do {
            scf.yield
          }
          // ================= layer 1 =================
          // stage 0 -- one task: a reduction over the whole row, so it
          // cannot be split by output slice the way the matmuls can.
          %hsingle0_1 = arith.constant 0 : index
          %ec1_0 = arith.constant 36 : i64
          %eo1_0 = arith.addi %stepev, %ec1_0 : i64
          %p1_0 = llvm.getelementptr %evptr[%eo1_0] : (!llvm.ptr, i64) -> !llvm.ptr, i8
          %cl1_0 = memref.atomic_rmw addi %one_s, %sq[%step, %L1, %hsingle0_1] : (i32, memref<2x28x224xi32>) -> i32
          %mine1_0 = arith.cmpi eq, %cl1_0, %zero_s : i32
          scf.if %mine1_0 {
            scf.for %m = %c0_s to %nat step %c1_s {
              %ss1 = scf.for %i = %c0_s to %cdim_s step %c1_s
                  iter_args(%s = %fzero_s) -> (f32) {
                %v = memref.load %sx[%m, %i] : memref<5x1024xf32>
                %sq2 = arith.mulf %v, %v : f32
                %s2 = arith.addf %s, %sq2 : f32
                scf.yield %s2 : f32
              }
              %mean1 = arith.divf %ss1, %fdim_s : f32
              %me1 = arith.addf %mean1, %eps_s : f32
              %rms1 = math.sqrt %me1 : f32
              scf.for %i = %c0_s to %cdim_s step %c1_s {
                %v = memref.load %sx[%m, %i] : memref<5x1024xf32>
                %nv = arith.divf %v, %rms1 : f32
                %nw = memref.load %sn1[%L1, %i] : memref<28x1024xf32>
                %rv = arith.mulf %nv, %nw : f32
